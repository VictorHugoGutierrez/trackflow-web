<%- include('../partials/head') %>

<div class="flex min-h-screen bg-background text-foreground">
  <%- include('partials/sidebar', { activeTab: 'logs' }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('partials/header', { breadcrumb: 'Monitoramento & Logs' }) %>

    <main class="flex-1 p-8 space-y-6 max-w-7xl w-full mx-auto overflow-y-auto">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Monitoramento de Infraestrutura</h1>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            Status dos provedores de nuvem, integrações de IA e auditoria de eventos em tempo real
          </p>
        </div>

        <button
          type="button"
          onclick="fetchLogs()"
          class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-900 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-200 transition-colors shadow-sm cursor-pointer self-start"
        >
          <svg id="refresh-logs-icon" class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Atualizar Eventos
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-card border border-slate-200 dark:border-slate-800 rounded-2xl p-6 space-y-4 shadow-sm">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <h3 class="font-semibold text-sm text-slate-900 dark:text-white">Banco de Dados Neon</h3>
            </div>
            <span id="badge-db-status" class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              HEALTHY
            </span>
          </div>
          <div class="space-y-1 text-xs text-slate-500 dark:text-slate-400">
            <div>Provedor: <strong id="val-db-provider" class="text-slate-800 dark:text-slate-200 font-mono">PostgreSQL (Neon)</strong></div>
            <div>Arquitetura: <span class="text-slate-600 dark:text-slate-300">Multi-tenant com isolamento estrito</span></div>
          </div>
        </div>

        <div class="bg-card border border-slate-200 dark:border-slate-800 rounded-2xl p-6 space-y-4 shadow-sm">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
              <h3 class="font-semibold text-sm text-slate-900 dark:text-white">Ollama (Engine IA)</h3>
            </div>
            <span id="badge-ollama-status" class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">
              CONNECTED
            </span>
          </div>
          <div class="space-y-1 text-xs text-slate-500 dark:text-slate-400">
            <div>Modelo Ativo: <strong id="val-ollama-model" class="text-purple-600 dark:text-purple-300 font-mono">gemma4</strong></div>
            <div>Relatórios Processados: <strong id="val-ollama-reports" class="text-slate-800 dark:text-slate-200 font-mono">--</strong></div>
          </div>
        </div>

        <div class="bg-card border border-slate-200 dark:border-slate-800 rounded-2xl p-6 space-y-4 shadow-sm">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
              <h3 class="font-semibold text-sm text-slate-900 dark:text-white">Resend (Notificações)</h3>
            </div>
            <span id="badge-resend-status" class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
              CONFIGURED
            </span>
          </div>
          <div class="space-y-1 text-xs text-slate-500 dark:text-slate-400">
            <div>Serviço: <span class="text-slate-800 dark:text-slate-200">E-mails Transacionais</span></div>
            <div>Disparos Pendentes: <strong id="val-resend-pending" class="text-slate-800 dark:text-slate-200 font-mono">0</strong></div>
          </div>
        </div>
      </div>

      <div class="bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-xl">
        <div class="h-11 px-6 bg-slate-900 border-b border-slate-800 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
            <span class="ml-3 text-xs font-mono font-medium text-slate-300">system.events.terminal</span>
          </div>
          <div class="flex items-center gap-3">
            <select
              id="filter-log-type"
              onchange="filterLogEvents()"
              class="bg-slate-950 border border-slate-800 text-slate-300 rounded-lg px-2.5 py-1 text-xs focus:outline-none cursor-pointer font-mono"
            >
              <option value="">TODOS OS EVENTOS</option>
              <option value="OLLAMA_SUMMARY">IA OLLAMA</option>
              <option value="RESEND_EMAIL">E-MAILS RESEND</option>
            </select>
          </div>
        </div>

        <div id="logs-container" class="p-6 font-mono text-xs space-y-2 max-h-[500px] overflow-y-auto bg-slate-950 text-slate-300">
          <div class="text-slate-400">Iniciando conexão com monitor de logs...</div>
        </div>
      </div>
    </main>
  </div>
</div>

<script>
  const API_URL = "<%= typeof apiUrl !== 'undefined' ? apiUrl : 'http://localhost:3333' %>";
  let allEvents = [];

  async function fetchLogs() {
    const icon = document.getElementById("refresh-logs-icon");
    if (icon) icon.classList.add("animate-spin");

    try {
      const res = await fetch(`${API_URL}/api/admin/logs`, {
        credentials: "include"
      });

      if (!res.ok) throw new Error("Erro ao obter logs");
      const result = await res.json();
      const services = result.data?.services || {};
      allEvents = result.data?.recentEvents || [];

      if (services.database) {
        document.getElementById("val-db-provider").textContent = services.database.provider || "PostgreSQL (Neon)";
        const badge = document.getElementById("badge-db-status");
        badge.textContent = (services.database.status || "HEALTHY").toUpperCase();
      }

      if (services.ollama) {
        document.getElementById("val-ollama-model").textContent = services.ollama.model || "gemma4";
        document.getElementById("val-ollama-reports").textContent = services.ollama.totalReportsProcessed ?? 0;
        const badge = document.getElementById("badge-ollama-status");
        badge.textContent = (services.ollama.status || "CONNECTED").toUpperCase();
      }

      if (services.resend) {
        document.getElementById("val-resend-pending").textContent = services.resend.pendingDispatches ?? 0;
        const badge = document.getElementById("badge-resend-status");
        badge.textContent = (services.resend.status || "CONFIGURED").toUpperCase();
      }

      renderLogs(allEvents);
    } catch (err) {
      console.error(err);
      document.getElementById("logs-container").innerHTML = `
        <div class="text-red-400">&gt; [FATAL] Falha na comunicação com a API administrativa.</div>
      `;
    } finally {
      if (icon) icon.classList.remove("animate-spin");
    }
  }

  function filterLogEvents() {
    const type = document.getElementById("filter-log-type").value;
    if (!type) {
      renderLogs(allEvents);
    } else {
      renderLogs(allEvents.filter(e => e.type === type));
    }
  }

  function renderLogs(events) {
    const container = document.getElementById("logs-container");
    if (!container) return;

    if (!events.length) {
      container.innerHTML = '<div class="text-slate-400">&gt; [LOG] Nenhum evento recente registrado.</div>';
      return;
    }

    const statusBadge = {
      SUCCESS: '<span class="text-emerald-400 font-semibold">[SUCCESS]</span>',
      DELIVERED: '<span class="text-blue-400 font-semibold">[DELIVERED]</span>',
      ERROR: '<span class="text-red-400 font-semibold">[ERROR]</span>',
      PENDING: '<span class="text-amber-400 font-semibold">[PENDING]</span>'
    };

    container.innerHTML = events.map(e => {
      const time = new Date(e.timestamp).toLocaleTimeString('pt-BR', { hour12: false });
      const badge = statusBadge[e.status] || `<span class="text-slate-300 font-semibold">[${e.status}]</span>`;
      return `
        <div class="flex items-start gap-3 py-1.5 border-b border-slate-900/60 hover:bg-slate-900/40 px-2 rounded transition-colors">
          <span class="text-slate-400 shrink-0">${time}</span>
          <span class="text-amber-400 font-semibold shrink-0">${e.type}</span>
          ${badge}
          <span class="text-slate-200 flex-1 break-words">${e.message}</span>
          <span class="text-slate-400 text-[10px] shrink-0 font-mono">${e.id}</span>
        </div>
      `;
    }).join("");
  }

  document.addEventListener("DOMContentLoaded", fetchLogs);
</script>

</body>
</html>
