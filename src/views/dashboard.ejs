<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-7xl w-full mx-auto px-6 py-8 space-y-6">
  <!-- Feedback Messages -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 text-xs bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 rounded-xl flex items-center justify-between shadow-sm">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        <span><%= success %></span>
      </div>
      <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-base leading-none">&times;</button>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 text-xs bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 rounded-xl flex items-center justify-between shadow-sm">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="2"/>
          <line x1="12" y1="8" x2="12" y2="12" stroke-width="2"/>
          <line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2"/>
        </svg>
        <span><%= error %></span>
      </div>
      <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-base leading-none">&times;</button>
    </div>
  <% } %>

  <div id="timer-feedback" class="hidden p-3 rounded-xl border text-xs"></div>

  <!-- Hero: O Cronômetro Imortal (Zero Friction Timer) -->
  <div class="bg-white dark:bg-[#1E293B] border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm space-y-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-4 border-b border-slate-100 dark:border-slate-800/80">
      <div>
        <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>Rastreador de Tempo</span>
          <span id="timer-live-badge" class="<%= activeEntry ? '' : 'hidden' %> text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center gap-1.5 animate-pulse">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Em andamento
          </span>
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          Inicie o cronômetro instantaneamente (fricção zero) ou vincule a um projeto
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          onclick="openProjectModal()"
          class="px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 hover:text-emerald-500 dark:hover:text-emerald-400 bg-slate-100 dark:bg-slate-800 rounded-xl transition-colors border border-slate-200 dark:border-slate-700 cursor-pointer"
        >
          + Novo Projeto
        </button>
        <button
          type="button"
          onclick="openTaskModal()"
          class="px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 hover:text-emerald-500 dark:hover:text-emerald-400 bg-slate-100 dark:bg-slate-800 rounded-xl transition-colors border border-slate-200 dark:border-slate-700 cursor-pointer"
        >
          + Nova Tarefa
        </button>
      </div>
    </div>

    <!-- Timer Inputs & Action Row -->
    <div class="flex flex-col lg:flex-row lg:items-center gap-4">
      <div class="flex-1">
        <input
          type="text"
          id="timer-description"
          placeholder="No que você está trabalhando agora?"
          value="<%= activeEntry && activeEntry.description ? activeEntry.description : '' %>"
          class="w-full px-4 py-3 bg-slate-50 dark:bg-[#0F172A] border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all font-medium"
        />
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <!-- Project Selector -->
        <select
          id="timer-project"
          class="px-3 py-3 bg-slate-50 dark:bg-[#0F172A] border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer max-w-[160px]"
        >
          <option value="">Sem projeto</option>
          <% if (projects && projects.length > 0) { %>
            <% projects.forEach(function(p) { %>
              <option value="<%= p.id %>" <%= activeEntry && activeEntry.projectId === p.id ? 'selected' : '' %>>
                <%= p.name %>
              </option>
            <% }); %>
          <% } %>
        </select>

        <!-- Task Selector -->
        <select
          id="timer-task"
          class="px-3 py-3 bg-slate-50 dark:bg-[#0F172A] border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer max-w-[160px]"
        >
          <option value="">Sem tarefa</option>
          <% if (tasks && tasks.length > 0) { %>
            <% tasks.forEach(function(t) { %>
              <option value="<%= t.id %>" <%= activeEntry && activeEntry.taskId === t.id ? 'selected' : '' %>>
                <%= t.title %>
              </option>
            <% }); %>
          <% } %>
        </select>

        <!-- Billable Checkbox -->
        <label class="flex items-center gap-2 px-3 py-3 bg-slate-50 dark:bg-[#0F172A] border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-700 dark:text-slate-300 cursor-pointer select-none">
          <input
            type="checkbox"
            id="timer-billable"
            <%= !activeEntry || activeEntry.billable ? 'checked' : '' %>
            class="w-4 h-4 rounded text-emerald-500 focus:ring-emerald-500"
          />
          <span>Faturável</span>
        </label>

        <!-- Big Digital Display -->
        <div class="px-4 py-2 bg-slate-100 dark:bg-[#0F172A] border border-slate-200 dark:border-slate-700 rounded-xl flex items-center justify-center min-w-[130px]">
          <span id="timer-display" class="text-2xl font-bold font-mono text-slate-900 dark:text-white tracking-wider">
            00:00:00
          </span>
        </div>

        <!-- Play/Stop Button -->
        <button
          type="button"
          id="btn-timer-action"
          onclick="toggleTimer()"
          class="h-12 px-6 rounded-xl font-bold text-sm flex items-center gap-2.5 transition-all shadow-md cursor-pointer <%= activeEntry ? 'bg-red-500 hover:bg-red-600 text-white shadow-red-500/20' : 'bg-emerald-500 hover:bg-emerald-600 text-white shadow-emerald-500/20' %>"
        >
          <% if (activeEntry) { %>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <rect x="5" y="5" width="14" height="14" rx="2" />
            </svg>
            <span id="btn-timer-label">Parar</span>
          <% } else { %>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
            <span id="btn-timer-label">Iniciar</span>
          <% } %>
        </button>
      </div>
    </div>
  </div>

  <!-- Operational Metrics Row -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="p-4 rounded-2xl bg-white dark:bg-[#1E293B] border border-slate-200 dark:border-slate-800 shadow-sm space-y-1">
      <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Horas Registradas Hoje</div>
      <div class="text-2xl font-bold text-slate-900 dark:text-white"><%= metrics ? metrics.hoursToday : '0.0' %>h</div>
      <div class="text-[11px] text-slate-400">Total acumulado hoje</div>
    </div>

    <div class="p-4 rounded-2xl bg-white dark:bg-[#1E293B] border border-slate-200 dark:border-slate-800 shadow-sm space-y-1">
      <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Aproveitamento Faturável</div>
      <div class="text-2xl font-bold text-emerald-600 dark:text-emerald-400"><%= metrics ? metrics.billablePercent : 100 %>%</div>
      <div class="text-[11px] text-slate-400">Horas cobráveis a clientes</div>
    </div>

    <div class="p-4 rounded-2xl bg-white dark:bg-[#1E293B] border border-slate-200 dark:border-slate-800 shadow-sm space-y-1">
      <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Apontamentos Hoje</div>
      <div class="text-2xl font-bold text-blue-600 dark:text-blue-400"><%= metrics ? metrics.entriesCountToday : 0 %></div>
      <div class="text-[11px] text-slate-400">Sessões de foco registradas</div>
    </div>

    <div class="p-4 rounded-2xl bg-white dark:bg-[#1E293B] border border-slate-200 dark:border-slate-800 shadow-sm space-y-1">
      <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Projetos Ativos</div>
      <div class="text-2xl font-bold text-purple-600 dark:text-purple-400"><%= metrics ? metrics.projectsCount : 0 %></div>
      <div class="text-[11px] text-slate-400">Disponíveis no workspace</div>
    </div>
  </div>

  <!-- Recent Time Entries Table -->
  <div class="bg-white dark:bg-[#1E293B] border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-sm space-y-3 p-6">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800/80">
      <div>
        <h3 class="text-sm font-bold text-slate-900 dark:text-white">Apontamentos Recentes</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Histórico das últimas sessões de tempo registradas</p>
      </div>
      <a href="/dashboard" class="text-xs text-emerald-500 hover:underline font-medium">Atualizar lista</a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 dark:bg-[#0F172A] border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 uppercase tracking-wider font-semibold">
          <tr>
            <th class="px-4 py-3">Atividade / Descrição</th>
            <th class="px-4 py-3">Projeto</th>
            <th class="px-4 py-3">Tarefa</th>
            <th class="px-4 py-3">Início &rarr; Fim</th>
            <th class="px-4 py-3">Duração</th>
            <th class="px-4 py-3">Tipo</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80">
          <% if (!timeEntries || timeEntries.length === 0) { %>
            <tr>
              <td colspan="6" class="px-4 py-8 text-center text-slate-400">
                Nenhum apontamento registrado ainda. Clique em <strong>Iniciar</strong> acima para começar seu primeiro rastreamento!
              </td>
            </tr>
          <% } else { %>
            <% timeEntries.forEach(function(entry) { %>
              <%
                const durSeconds = entry.duration || 0;
                const durH = Math.floor(durSeconds / 3600);
                const durM = Math.floor((durSeconds % 3600) / 60);
                const durFormatted = durH > 0 ? `${durH}h ${durM}m` : `${durM}m ${durSeconds % 60}s`;
                const startTimeFormatted = new Date(entry.start).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
                const endTimeFormatted = entry.end ? new Date(entry.end).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) : 'Em andamento';
              %>
              <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
                <td class="px-4 py-3 font-medium text-slate-900 dark:text-white">
                  <%= entry.description || '(Sem descrição)' %>
                </td>
                <td class="px-4 py-3">
                  <% if (entry.project) { %>
                    <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
                      <%= entry.project.name %>
                    </span>
                  <% } else { %>
                    <span class="text-slate-400">-</span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-slate-600 dark:text-slate-300">
                  <%= entry.task ? entry.task.title : '-' %>
                </td>
                <td class="px-4 py-3 text-slate-500 dark:text-slate-400 font-mono text-[11px]">
                  <%= startTimeFormatted %> &rarr; <%= endTimeFormatted %>
                </td>
                <td class="px-4 py-3 font-mono font-semibold text-slate-800 dark:text-slate-200">
                  <% if (!entry.end) { %>
                    <span class="text-emerald-500 font-bold animate-pulse">Rodando...</span>
                  <% } else { %>
                    <%= durFormatted %>
                  <% } %>
                </td>
                <td class="px-4 py-3">
                  <% if (entry.billable) { %>
                    <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                      Faturável
                    </span>
                  <% } else { %>
                    <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                      Não faturável
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<!-- Modal Novo Projeto -->
<div id="modal-project" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white dark:bg-[#1E293B] border border-slate-200 dark:border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-4 text-xs shadow-2xl">
    <div class="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white">Criar Novo Projeto</h3>
      <button type="button" onclick="closeProjectModal()" class="text-slate-400 hover:text-white p-1 rounded-lg">&times;</button>
    </div>

    <form method="POST" action="/projects" class="space-y-4">
      <div class="space-y-1">
        <label for="project-name" class="block text-slate-700 dark:text-slate-300 font-medium">Nome do Projeto</label>
        <input
          type="text"
          id="project-name"
          name="name"
          required
          placeholder="Ex: Redesign da Landing Page"
          class="w-full px-3 py-2 bg-slate-50 dark:bg-[#0F172A] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <div class="space-y-1">
        <label for="project-budget" class="block text-slate-700 dark:text-slate-300 font-medium">Orçamento Estimado (Horas)</label>
        <input
          type="number"
          step="0.5"
          id="project-budget"
          name="budgetHours"
          placeholder="Ex: 40"
          class="w-full px-3 py-2 bg-slate-50 dark:bg-[#0F172A] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-200 dark:border-slate-800">
        <button
          type="button"
          onclick="closeProjectModal()"
          class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-semibold shadow-sm"
        >
          Criar Projeto
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Nova Tarefa -->
<div id="modal-task" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white dark:bg-[#1E293B] border border-slate-200 dark:border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-4 text-xs shadow-2xl">
    <div class="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white">Criar Nova Tarefa</h3>
      <button type="button" onclick="closeTaskModal()" class="text-slate-400 hover:text-white p-1 rounded-lg">&times;</button>
    </div>

    <form method="POST" action="/tasks" class="space-y-4">
      <div class="space-y-1">
        <label for="task-project" class="block text-slate-700 dark:text-slate-300 font-medium">Projeto Vinculado</label>
        <select
          id="task-project"
          name="projectId"
          required
          class="w-full px-3 py-2 bg-slate-50 dark:bg-[#0F172A] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
        >
          <option value="">Selecione um projeto...</option>
          <% if (projects && projects.length > 0) { %>
            <% projects.forEach(function(p) { %>
              <option value="<%= p.id %>"><%= p.name %></option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <div class="space-y-1">
        <label for="task-title" class="block text-slate-700 dark:text-slate-300 font-medium">Título da Tarefa</label>
        <input
          type="text"
          id="task-title"
          name="title"
          required
          placeholder="Ex: Implementar fluxo de autenticação"
          class="w-full px-3 py-2 bg-slate-50 dark:bg-[#0F172A] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <div class="space-y-1">
        <label for="task-hours" class="block text-slate-700 dark:text-slate-300 font-medium">Horas Estimadas</label>
        <input
          type="number"
          step="0.5"
          id="task-hours"
          name="estimatedHours"
          placeholder="Ex: 8"
          class="w-full px-3 py-2 bg-slate-50 dark:bg-[#0F172A] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-200 dark:border-slate-800">
        <button
          type="button"
          onclick="closeTaskModal()"
          class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-semibold shadow-sm"
        >
          Criar Tarefa
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const API_URL = "<%= typeof apiUrl !== 'undefined' ? apiUrl : 'http://localhost:3333' %>";

  // Estado do Cronômetro Imortal
  let isRunning = false;
  let activeEntryId = null;
  let startTime = null;
  let timerInterval = null;

  // Carregar estado inicial (SSR + persistência em localStorage)
  const initialActive = <%- JSON.stringify(activeEntry || null) %>;

  function initTimer() {
    if (initialActive && initialActive.id) {
      isRunning = true;
      activeEntryId = initialActive.id;
      startTime = new Date(initialActive.start).getTime();
      saveTimerState();
      startInterval();
      updateButtonUI(true);
    } else {
      const saved = loadTimerState();
      if (saved && saved.isRunning && saved.startTime) {
        isRunning = true;
        activeEntryId = saved.activeEntryId;
        startTime = Number(saved.startTime);
        if (saved.description) document.getElementById("timer-description").value = saved.description;
        if (saved.projectId) document.getElementById("timer-project").value = saved.projectId;
        if (saved.taskId) document.getElementById("timer-task").value = saved.taskId;
        if (saved.billable !== undefined) document.getElementById("timer-billable").checked = saved.billable;
        startInterval();
        updateButtonUI(true);
      } else {
        updateTimerDisplay(0);
        updateButtonUI(false);
      }
    }
  }

  function startInterval() {
    if (timerInterval) clearInterval(timerInterval);
    updateTick();
    timerInterval = setInterval(updateTick, 1000);
  }

  function updateTick() {
    if (!startTime) return;
    const elapsed = Math.max(0, Math.floor((Date.now() - startTime) / 1000));
    updateTimerDisplay(elapsed);
  }

  function updateTimerDisplay(totalSeconds) {
    const hrs = String(Math.floor(totalSeconds / 3600)).padStart(2, '0');
    const mins = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
    const secs = String(totalSeconds % 60).padStart(2, '0');
    document.getElementById("timer-display").textContent = `${hrs}:${mins}:${secs}`;
  }

  function saveTimerState() {
    localStorage.setItem("trackflow_timer_storage", JSON.stringify({
      isRunning,
      activeEntryId,
      startTime,
      description: document.getElementById("timer-description").value,
      projectId: document.getElementById("timer-project").value,
      taskId: document.getElementById("timer-task").value,
      billable: document.getElementById("timer-billable").checked,
    }));
  }

  function loadTimerState() {
    try {
      const data = localStorage.getItem("trackflow_timer_storage");
      return data ? JSON.parse(data) : null;
    } catch {
      return null;
    }
  }

  function clearTimerState() {
    localStorage.removeItem("trackflow_timer_storage");
  }

  function updateButtonUI(running) {
    const btn = document.getElementById("btn-timer-action");
    const label = document.getElementById("btn-timer-label");
    const liveBadge = document.getElementById("timer-live-badge");

    if (running) {
      btn.className = "h-12 px-6 rounded-xl font-bold text-sm flex items-center gap-2.5 transition-all shadow-md cursor-pointer bg-red-500 hover:bg-red-600 text-white shadow-red-500/20";
      btn.innerHTML = `
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <rect x="5" y="5" width="14" height="14" rx="2" />
        </svg>
        <span id="btn-timer-label">Parar</span>
      `;
      if (liveBadge) liveBadge.classList.remove("hidden");
    } else {
      btn.className = "h-12 px-6 rounded-xl font-bold text-sm flex items-center gap-2.5 transition-all shadow-md cursor-pointer bg-emerald-500 hover:bg-emerald-600 text-white shadow-emerald-500/20";
      btn.innerHTML = `
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
        <span id="btn-timer-label">Iniciar</span>
      `;
      if (liveBadge) liveBadge.classList.add("hidden");
    }
  }

  async function toggleTimer() {
    const feedback = document.getElementById("timer-feedback");
    feedback.className = "hidden p-3 rounded-xl border text-xs";

    const description = document.getElementById("timer-description").value.trim();
    const projectId = document.getElementById("timer-project").value || undefined;
    const taskId = document.getElementById("timer-task").value || undefined;
    const billable = document.getElementById("timer-billable").checked;

    if (!isRunning) {
      // Iniciar Timer (Fricção Zero)
      try {
        const res = await fetch("/time-entries/start", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json" },
          body: JSON.stringify({ description, projectId, taskId, billable }),
        });
        const result = await res.json();
        if (!res.ok || !result.success) {
          throw new Error(result.error?.message || "Falha ao iniciar o cronômetro.");
        }

        isRunning = true;
        activeEntryId = result.data?.id;
        startTime = Date.now();
        saveTimerState();
        startInterval();
        updateButtonUI(true);
      } catch (err) {
        feedback.className = "p-3 rounded-xl border text-xs bg-red-500/10 border-red-500/20 text-red-500";
        feedback.textContent = err.message;
      }
    } else {
      // Parar Timer
      try {
        const res = await fetch("/time-entries/stop", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json" },
          body: JSON.stringify({ id: activeEntryId, description, projectId, taskId, billable }),
        });
        const result = await res.json();
        if (!res.ok || !result.success) {
          throw new Error(result.error?.message || "Falha ao parar o cronômetro.");
        }

        isRunning = false;
        clearInterval(timerInterval);
        clearTimerState();
        updateTimerDisplay(0);
        updateButtonUI(false);
        window.location.reload();
      } catch (err) {
        feedback.className = "p-3 rounded-xl border text-xs bg-red-500/10 border-red-500/20 text-red-500";
        feedback.textContent = err.message;
      }
    }
  }

  function openProjectModal() {
    document.getElementById("modal-project").classList.remove("hidden");
  }
  function closeProjectModal() {
    document.getElementById("modal-project").classList.add("hidden");
  }

  function openTaskModal() {
    document.getElementById("modal-task").classList.remove("hidden");
  }
  function closeTaskModal() {
    document.getElementById("modal-task").classList.add("hidden");
  }

  document.addEventListener("DOMContentLoaded", initTimer);
</script>

</body>
</html>
