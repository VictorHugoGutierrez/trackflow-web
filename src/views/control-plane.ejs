<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-7xl w-full mx-auto px-6 py-12 flex flex-col items-center justify-center text-center space-y-4">
  <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-500">
    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
    </svg>
  </div>

  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
    Control Plane Administrativo
  </h1>
  <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md">
    Acesso restrito para <strong class="text-amber-500">SUPER_ADMIN</strong> (<%= user ? user.email : '' %>). As ferramentas de gestão global de tenants serão desenvolvidas a seguir.
  </p>

  <div class="pt-4">
    <a href="/logout" class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-red-500 dark:hover:text-red-400 bg-slate-100 dark:bg-slate-800 hover:bg-red-50 dark:hover:bg-red-950/30 rounded-xl transition-colors border border-slate-200 dark:border-slate-700">
      Encerrar Sessão
    </a>
  </div>
</main>

<%- include('partials/footer') %>
