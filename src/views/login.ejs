<%- include('partials/head') %>

<main class="flex-1 flex items-center justify-center p-6">
  <div class="w-full max-w-md space-y-6">
    <div class="text-center space-y-2">
      <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-500 mx-auto">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="2"/>
          <polyline points="12 6 12 12 16 14" stroke-width="2"/>
        </svg>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">TrackFlow</h1>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Gestão de tempo, clientes e projetos com isolamento multi-tenant
      </p>
    </div>

    <div class="bg-white dark:bg-[#1E293B] border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-xl space-y-5">
      <div class="flex border-b border-slate-200 dark:border-slate-800">
        <button
          type="button"
          id="tab-login"
          onclick="switchTab('login')"
          class="flex-1 pb-3 text-center text-sm font-semibold text-emerald-500 border-b-2 border-emerald-500 transition-colors cursor-pointer"
        >
          Entrar
        </button>
        <button
          type="button"
          id="tab-register"
          onclick="switchTab('register')"
          class="flex-1 pb-3 text-center text-sm font-medium text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 border-b-2 border-transparent transition-colors cursor-pointer"
        >
          Criar Conta
        </button>
      </div>

      <div id="error-box" class="hidden p-3 text-xs bg-red-500/10 border border-red-500/20 text-red-500 rounded-xl"></div>
      <div id="success-box" class="hidden p-3 text-xs bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 rounded-xl"></div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-3 text-xs bg-red-500/10 border border-red-500/20 text-red-500 rounded-xl">
          <%= error %>
        </div>
      <% } %>

      <form id="form-login" onsubmit="handleEmailLogin(event)" class="space-y-4">
        <div class="space-y-1">
          <label for="login-email" class="block text-xs font-medium text-slate-700 dark:text-slate-300">
            E-mail
          </label>
          <input
            type="email"
            id="login-email"
            name="email"
            required
            autocomplete="email"
            placeholder="seu@email.com"
            class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#0F172A] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all"
          />
        </div>

        <div class="space-y-1">
          <label for="login-password" class="block text-xs font-medium text-slate-700 dark:text-slate-300">
            Senha
          </label>
          <input
            type="password"
            id="login-password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
            class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#0F172A] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all"
          />
        </div>

        <button
          type="submit"
          id="btn-login-submit"
          class="w-full h-11 flex items-center justify-center font-semibold text-sm rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white shadow-sm transition-colors cursor-pointer"
        >
          Entrar na plataforma
        </button>
      </form>

      <form id="form-register" onsubmit="handleRegister(event)" class="space-y-4 hidden">
        <div class="space-y-1">
          <label for="register-name" class="block text-xs font-medium text-slate-700 dark:text-slate-300">
            Nome Completo
          </label>
          <input
            type="text"
            id="register-name"
            name="name"
            required
            autocomplete="name"
            placeholder="Seu Nome Completo"
            class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#0F172A] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all"
          />
        </div>

        <div class="space-y-1">
          <label for="register-email" class="block text-xs font-medium text-slate-700 dark:text-slate-300">
            E-mail
          </label>
          <input
            type="email"
            id="register-email"
            name="email"
            required
            autocomplete="email"
            placeholder="seu@empresa.com"
            class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#0F172A] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all"
          />
        </div>

        <div class="space-y-1">
          <label for="register-password" class="block text-xs font-medium text-slate-700 dark:text-slate-300">
            Senha (mínimo 6 caracteres)
          </label>
          <input
            type="password"
            id="register-password"
            name="password"
            required
            minlength="6"
            autocomplete="new-password"
            placeholder="••••••••"
            class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#0F172A] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all"
          />
        </div>

        <div class="space-y-1">
          <label for="register-workspace" class="block text-xs font-medium text-slate-700 dark:text-slate-300">
            Nome da Empresa / Workspace (Opcional)
          </label>
          <input
            type="text"
            id="register-workspace"
            name="workspaceName"
            placeholder="Minha Empresa"
            class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#0F172A] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all"
          />
        </div>

        <button
          type="submit"
          id="btn-register-submit"
          class="w-full h-11 flex items-center justify-center font-semibold text-sm rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white shadow-sm transition-colors cursor-pointer"
        >
          Criar minha conta
        </button>
      </form>

      <div class="relative flex items-center justify-center py-2">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-slate-200 dark:border-slate-700"></div>
        </div>
        <span class="relative px-3 bg-white dark:bg-[#1E293B] text-xs uppercase tracking-wider text-slate-400">
          ou continue com
        </span>
      </div>

      <button
        type="button"
        id="google-login-btn"
        onclick="handleGoogleAuth()"
        class="w-full h-11 flex items-center justify-center gap-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-medium rounded-xl hover:opacity-90 transition-opacity shadow-sm text-sm cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24">
          <path
            fill="#4285F4"
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
          />
          <path
            fill="#34A853"
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
          />
          <path
            fill="#FBBC05"
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
          />
          <path
            fill="#EA4335"
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
          />
        </svg>
        <span id="btn-google-text">Continuar com Google</span>
      </button>
    </div>
  </div>
</main>

<script>
  const API_URL = "<%= typeof apiUrl !== 'undefined' ? apiUrl : 'http://localhost:3333' %>";

  function switchTab(mode) {
    const tabLogin = document.getElementById('tab-login');
    const tabRegister = document.getElementById('tab-register');
    const formLogin = document.getElementById('form-login');
    const formRegister = document.getElementById('form-register');
    clearFeedback();

    if (mode === 'login') {
      tabLogin.classList.add('text-emerald-500', 'border-emerald-500');
      tabLogin.classList.remove('text-slate-400', 'border-transparent');
      tabRegister.classList.add('text-slate-400', 'border-transparent');
      tabRegister.classList.remove('text-emerald-500', 'border-emerald-500');
      formLogin.classList.remove('hidden');
      formRegister.classList.add('hidden');
    } else {
      tabRegister.classList.add('text-emerald-500', 'border-emerald-500');
      tabRegister.classList.remove('text-slate-400', 'border-transparent');
      tabLogin.classList.add('text-slate-400', 'border-transparent');
      tabLogin.classList.remove('text-emerald-500', 'border-emerald-500');
      formRegister.classList.remove('hidden');
      formLogin.classList.add('hidden');
    }
  }

  function clearFeedback() {
    const errorBox = document.getElementById('error-box');
    const successBox = document.getElementById('success-box');
    errorBox.textContent = '';
    errorBox.classList.add('hidden');
    successBox.textContent = '';
    successBox.classList.add('hidden');
  }

  function showError(msg) {
    const errorBox = document.getElementById('error-box');
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  }

  function showSuccess(msg) {
    const successBox = document.getElementById('success-box');
    successBox.textContent = msg;
    successBox.classList.remove('hidden');
  }

  function handleAuthSuccess(data) {
    if (data.token) {
      localStorage.setItem('trackflow_token', data.token);
    }
    const role = data.user?.role;
    window.location.href = role === 'SUPER_ADMIN' ? '/control-plane' : '/dashboard';
  }

  async function handleEmailLogin(event) {
    event.preventDefault();
    clearFeedback();

    const email = document.getElementById('login-email').value;
    const password = document.getElementById('login-password').value;
    const btn = document.getElementById('btn-login-submit');
    const originalText = btn.textContent;
    btn.textContent = 'Entrando...';
    btn.disabled = true;

    try {
      const res = await fetch(`${API_URL}/api/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ email, password }),
      });

      const result = await res.json();

      if (!res.ok || !result.success) {
        throw new Error(result.error?.message || result.message || 'Falha ao autenticar.');
      }

      handleAuthSuccess(result.data);
    } catch (err) {
      showError(err.message);
      btn.textContent = originalText;
      btn.disabled = false;
    }
  }

  async function handleRegister(event) {
    event.preventDefault();
    clearFeedback();

    const name = document.getElementById('register-name').value;
    const email = document.getElementById('register-email').value;
    const password = document.getElementById('register-password').value;
    const workspaceName = document.getElementById('register-workspace').value;

    const btn = document.getElementById('btn-register-submit');
    const originalText = btn.textContent;
    btn.textContent = 'Criando conta...';
    btn.disabled = true;

    try {
      const res = await fetch(`${API_URL}/api/auth/register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ name, email, password, workspaceName: workspaceName || undefined }),
      });

      const result = await res.json();

      if (!res.ok || !result.success) {
        throw new Error(result.error?.message || result.message || 'Falha ao criar conta.');
      }

      showSuccess('Conta criada com sucesso! Redirecionando...');
      setTimeout(() => {
        handleAuthSuccess(result.data);
      }, 700);
    } catch (err) {
      showError(err.message);
      btn.textContent = originalText;
      btn.disabled = false;
    }
  }

  async function handleGoogleAuth(mockToken) {
    clearFeedback();
    const btnText = document.getElementById('btn-google-text');
    const originalText = btnText.textContent;
    btnText.textContent = 'Autenticando...';

    const idToken = mockToken || 'simulated_google_token';

    try {
      const res = await fetch(`${API_URL}/api/auth/google`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ idToken, googleToken: idToken }),
      });

      const result = await res.json();

      if (!res.ok || !result.success) {
        throw new Error(result.error?.message || result.message || 'Falha na autenticação com o Google.');
      }

      handleAuthSuccess(result.data);
    } catch (err) {
      showError(err.message);
      btnText.textContent = originalText;
    }
  }
</script>

<%- include('partials/footer') %>
