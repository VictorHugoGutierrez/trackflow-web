      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Resumo Executivo (IA / Discriminação)</label>
          <button
            type="button"
            id="btn-modal-ai"
