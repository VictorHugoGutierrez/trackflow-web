          >
            <span>✨ Gerar com Ollama Cloud agora</span>
          </button>
        </div>
        <textarea
          name="aiSummary"
          id="invoice-ai-summary"
          rows="4"
          placeholder="Clique em 'Gerar com Ollama Cloud agora' ou marque a opção abaixo para gerar automaticamente ao emitir..."
          class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-background border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 font-sans"
        ></textarea>
        <label class="flex items-center gap-2 mt-1.5 cursor-pointer select-none">
          <input type="checkbox" name="generateAi" value="true" checked class="w-3.5 h-3.5 rounded text-purple-600 focus:ring-purple-500" />
          <span class="text-[11px] text-slate-500 dark:text-slate-400">Gerar resumo executivo automaticamente via Ollama (<code>gpt-oss:120b</code>) caso o campo esteja em branco</span>
        </label>
      </div>

      <div class="p-3.5 bg-slate-50 dark:bg-background rounded-xl border border-slate-200 dark:border-slate-700 space-y-2.5">
        <label class="flex items-center gap-2 cursor-pointer select-none">
          <input type="checkbox" name="sendEmail" id="invoice-send-email-check" value="true" class="w-4 h-4 rounded text-emerald-500 focus:ring-emerald-500" />
          <span class="text-xs font-semibold text-slate-700 dark:text-slate-200">Disparar fatura por e-mail imediatamente (via Resend)</span>
        </label>
        <input
          type="email"
          name="recipientEmail"
          id="invoice-recipient-email"
          placeholder="E-mail do destinatário (padrão: contato do cliente ou hugovictorgutierrez@gmail.com)"
          class="w-full px-3 py-2 bg-card border border-slate-200 dark:border-slate-700 rounded-lg text-xs text-slate-900 dark:text-white font-mono"
        />
      </div>

      <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100 dark:border-slate-800">
        <button type="button" onclick="closeInvoiceModal()" class="px-4 py-2 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl cursor-pointer">Cancelar</button>
