<!-- Form Auxiliar para Alteração de Status (PATCH /reports/invoices/:id/status) -->
<form id="form-status-update" method="POST" class="hidden">
  <input type="hidden" name="status" id="form-status-input" value="pago" />
</form>

<script>
  function formatDurationJs(seconds) {
    const total = Math.max(0, Math.floor(Number(seconds) || 0));
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    return [h, m, s].map((v) => String(v).padStart(2, '0')).join(':');
  }

  function openInvoiceModal() {
    document.getElementById('modal-invoice').classList.remove('hidden');
    onInvoiceClientOrMonthChange();
  }

  function closeInvoiceModal() {
    document.getElementById('modal-invoice').classList.add('hidden');
  }

  function openSendInvoiceModal(btn) {
    const id = btn.getAttribute('data-id');
    const clientName = btn.getAttribute('data-client') || 'Cliente';
    const email = btn.getAttribute('data-email') || 'hugovictorgutierrez@gmail.com';
    const monthRef = btn.getAttribute('data-month') || '';

    const form = document.getElementById('form-send-invoice');
    form.action = `/reports/invoices/${id}/send`;

    document.getElementById('send-modal-subtitle').textContent = `${clientName} • Ref: ${monthRef}`;
    document.getElementById('send-invoice-to').value = email;
    document.getElementById('send-invoice-subject').value = `Fatura TrackFlow - ${clientName} (${monthRef})`;
    document.getElementById('modal-send-email').classList.remove('hidden');
  }

  function closeSendInvoiceModal() {
    document.getElementById('modal-send-email').classList.add('hidden');
  }

  function openAiSummaryModalFromBtn(btn) {
    const summary = decodeURIComponent(btn.getAttribute('data-summary') || '');
    const client = btn.getAttribute('data-client') || 'Cliente';
    const month = btn.getAttribute('data-month') || '';
    document.getElementById('view-ai-subtitle').textContent = `${client} • Competência ${month}`;
    document.getElementById('view-ai-body').textContent = summary;
    document.getElementById('modal-view-ai').classList.remove('hidden');
  }

  function closeViewAiModal() {
    document.getElementById('modal-view-ai').classList.add('hidden');
  }

  function openPdfPreviewModal(btn) {
    const pdfUrl = btn.getAttribute('data-pdf') || '';
    const client = btn.getAttribute('data-client') || 'Cliente';
    const month = btn.getAttribute('data-month') || '';
    document.getElementById('view-pdf-title').textContent = `Fatura — ${client} (${month})`;
    const iframe = document.getElementById('invoice-pdf-iframe');
    iframe.src = pdfUrl;
    document.getElementById('modal-view-pdf').classList.remove('hidden');
  }

  function closePdfPreviewModal() {
    const iframe = document.getElementById('invoice-pdf-iframe');
    iframe.src = 'about:blank';
    document.getElementById('modal-view-pdf').classList.add('hidden');
  }

  function printInvoiceIframe() {
    const iframe = document.getElementById('invoice-pdf-iframe');
    if (iframe && iframe.contentWindow) {
      iframe.contentWindow.focus();
      iframe.contentWindow.print();
    }
  }

  function copyAiSummary() {
    const text = document.getElementById('ai-summary-content').textContent || '';
    if (text && navigator.clipboard) {
      navigator.clipboard.writeText(text);
    }
  }

  // 1. Consulta dinâmica a GET /api/reports/summary quando o cliente ou mês muda no modal de fatura
  async function onInvoiceClientOrMonthChange() {
    const select = document.getElementById('invoice-client-select');
    const monthInput = document.getElementById('invoice-month-input');
    const clientId = select ? select.value : '';
    const month = monthInput ? monthInput.value : '<%= curMonth %>';

    if (select && select.selectedIndex >= 0) {
      const opt = select.options[select.selectedIndex];
      const email = opt ? opt.getAttribute('data-email') : '';
      const emailInput = document.getElementById('invoice-recipient-email');
      if (emailInput && email && email.includes('@')) {
        emailInput.value = email;
      }
    }

    if (!clientId) return;

    try {
      const res = await fetch(`/api/reports/summary?clientId=${encodeURIComponent(clientId)}&month=${encodeURIComponent(month)}`, {
        headers: { 'Accept': 'application/json' }
      });
      const json = await res.json();
      if (json.success && json.data) {
        const d = json.data;
        const summarySeconds =
          d.billableSeconds !== undefined
            ? Number(d.billableSeconds)
            : d.totalSeconds !== undefined
              ? Number(d.totalSeconds)
              : Math.round(Number(d.billableHours ?? d.totalHours ?? 0) * 3600);
        const summaryHours = Number((d.billableHours ?? d.totalHours ?? (summarySeconds / 3600)).toFixed(2));
        const summaryReais =
          d.amountCents !== undefined
            ? (Number(d.amountCents) / 100).toFixed(2)
            : Number(d.totalValue ?? 0).toFixed(2);

        const durSecEl = document.getElementById('invoice-duration-seconds');
        const hoursEl = document.getElementById('invoice-total-hours');
        const durDispEl = document.getElementById('invoice-duration-display');
        const valEl = document.getElementById('invoice-total-value');

        if (durSecEl) durSecEl.value = summarySeconds;
        if (hoursEl) hoursEl.value = summaryHours;
        if (durDispEl) durDispEl.value = formatDurationJs(summarySeconds);
        if (valEl) valEl.value = summaryReais;
      }
    } catch (err) {
      console.warn('Não foi possível atualizar o cálculo dinâmico da fatura:', err);
    }
  }

  // 2. Dispara POST /api/reports/ai-insight no Hero Card
  async function triggerAiSummary() {
    const clientSelect = document.getElementById('filter-client');
    const projectSelect = document.getElementById('filter-project');
    const monthInput = document.getElementById('filter-month');

    const clientId = clientSelect ? clientSelect.value : '';
    const projectId = projectSelect ? projectSelect.value : '';
    const monthRef = monthInput ? monthInput.value : '<%= curMonth %>';

    const btn = document.getElementById('btn-ai-summary');
    const icon = document.getElementById('ai-icon');
    const btnText = document.getElementById('ai-btn-text');

    btn.disabled = true;
    icon.classList.remove('hidden');
    btnText.textContent = 'Consultando Ollama Cloud (gpt-oss:120b)...';

    try {
      const res = await fetch('/api/reports/ai-insight', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          clientId: clientId || undefined,
          projectId: projectId || undefined,
          monthRef,
          startDate: '<%= startDate %>',
          endDate: '<%= endDate %>'
        })
      });

      const json = await res.json();
      if (json.success && json.data) {
        const summary = json.data.summary || json.data.insight || '';
        const metaTime =
          json.data.formattedDuration ||
          (json.data.durationSeconds !== undefined
            ? formatDurationJs(json.data.durationSeconds)
            : `${json.data.totalHours ?? 0}h`);

        document.getElementById('ai-summary-content').textContent = summary;
        document.getElementById('ai-summary-meta').textContent =
          `${json.data.clientName || 'Todos os Clientes'} • ${metaTime} (${json.data.totalEntries ?? 0} apontamentos)`;
        document.getElementById('ai-summary-card').classList.remove('hidden');
        const modalTextarea = document.getElementById('invoice-ai-summary');
        if (modalTextarea) modalTextarea.value = summary;
      } else {
        alert(json.error?.message || 'Não foi possível gerar o insight com IA.');
      }
    } catch (e) {
      alert('Falha na comunicação com o serviço de IA (Ollama Cloud).');
    } finally {
      btn.disabled = false;
      icon.classList.add('hidden');
      btnText.textContent = '✨ Gerar Insight com IA (gpt-oss:120b)';
    }
  }

  // Dispara POST /api/reports/ai-insight direto de dentro do Modal de Fatura
  async function generateAiInsideModal() {
    const clientSelect = document.getElementById('invoice-client-select');
    const monthInput = document.getElementById('invoice-month-input');
    const btn = document.getElementById('btn-modal-ai');
    const textarea = document.getElementById('invoice-ai-summary');

    const clientId = clientSelect ? clientSelect.value : '';
    const monthRef = monthInput ? monthInput.value : '<%= curMonth %>';

    btn.disabled = true;
    const originalText = btn.innerHTML;
    btn.textContent = '⏳ Gerando com Ollama Cloud...';

    try {
      const res = await fetch('/api/reports/ai-insight', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          clientId: clientId || undefined,
          monthRef
        })
      });
      const json = await res.json();
      if (json.success && json.data) {
        textarea.value = json.data.summary || json.data.insight || '';
      } else {
        alert(json.error?.message || 'Erro ao gerar resumo executivo com IA.');
      }
    } catch (err) {
      alert('Erro ao conectar ao Ollama Cloud.');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  }

  // 5. Atualiza status da fatura via PATCH /api/invoices/:id/status (ou fallback form POST)
  async function changeInvoiceStatus(id, newStatus) {
    try {
      const res = await fetch(`/api/invoices/${id}/status`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ status: newStatus })
      });
      const json = await res.json();
      if (json.success) {
        window.location.href = '/reports?success=Status+da+fatura+atualizado+para+' + encodeURIComponent(newStatus);
        return;
      }
      alert(json.error?.message || 'Erro ao atualizar status da fatura.');
    } catch (err) {
      const form = document.getElementById('form-status-update');
      document.getElementById('form-status-input').value = newStatus;
      form.action = `/reports/invoices/${id}/status`;
      form.submit();
    }
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeInvoiceModal();
      closeSendInvoiceModal();
      closeViewAiModal();
      closePdfPreviewModal();
    }
  });
</script>
