<%- include('../partials/head') %>

<%
  const curMonth = (typeof selectedMonth !== 'undefined' && selectedMonth) ? selectedMonth : new Date().toISOString().slice(0, 7);
  const curClientId = (typeof selectedClientId !== 'undefined') ? selectedClientId : '';
  const curProjectId = (typeof selectedProjectId !== 'undefined') ? selectedProjectId : '';
%>

<div class="flex h-screen overflow-hidden bg-background text-foreground">
  <%- include('../partials/tenant-sidebar', { activeTab: 'reports' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../partials/tenant-header') %>

    <main class="flex-1 p-4 md:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">
      <!-- Feedback Messages -->
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="p-4 text-xs bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 rounded-xl flex items-center justify-between shadow-sm">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span><%= success %></span>
          </div>
          <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-base leading-none">&times;</button>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-4 text-xs bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 rounded-xl flex items-center justify-between shadow-sm">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke-width="2"/>
              <line x1="12" y1="8" x2="12" y2="12" stroke-width="2"/>
              <line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2"/>
            </svg>
            <span><%= error %></span>
          </div>
          <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-base leading-none">&times;</button>
        </div>
      <% } %>

      <!-- Top Section: Header & Filters -->
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 pb-2 border-b border-slate-200 dark:border-slate-800">
        <div>
          <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white flex flex-wrap items-center gap-2.5">
            <span>IA, Relatórios & Faturamento</span>
            <span class="px-2.5 py-0.5 text-[10px] font-mono font-semibold uppercase rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">
              Ollama Cloud • gpt-oss:120b
            </span>
          </h1>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Apuração consolidada por projeto, insights executivos com IA e faturamento automatizado via Resend
          </p>
        </div>

        <!-- Filter Form (GET /reports -> GET /api/reports/summary) -->
        <form method="GET" action="/reports" class="flex flex-wrap items-center gap-2">
          <div>
            <input
              type="month"
              name="month"
              id="filter-month"
              value="<%= curMonth %>"
              class="px-3 py-1.5 bg-card border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-emerald-500 font-mono"
            />
          </div>

          <div>
            <select
              name="clientId"
              id="filter-client"
              class="px-3 py-1.5 bg-card border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-emerald-500"
            >
              <option value="">Todos os clientes</option>
              <% if (clients && clients.length > 0) { %>
                <% clients.forEach(function(c) { %>
                  <option value="<%= c.id %>" data-email="<%= c.contact || '' %>" <%= curClientId === c.id ? 'selected' : '' %>>
                    <%= c.name %>
                  </option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <div>
            <select
              name="projectId"
              id="filter-project"
              class="px-3 py-1.5 bg-card border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-emerald-500"
            >
              <option value="">Todos os projetos</option>
              <% if (typeof projects !== 'undefined' && projects && projects.length > 0) { %>
                <% projects.forEach(function(p) { %>
                  <% if (!curClientId || p.clientId === curClientId) { %>
                    <option value="<%= p.id %>" <%= curProjectId === p.id ? 'selected' : '' %>>
                      <%= p.name %>
                    </option>
                  <% } %>
                <% }); %>
              <% } %>
            </select>
          </div>

          <button
            type="submit"
            class="px-3.5 py-1.5 bg-play hover:bg-play/90 text-white rounded-xl text-xs font-semibold transition-colors shadow-sm cursor-pointer"
          >
            Filtrar Período
          </button>

          <% if (curClientId || curProjectId) { %>
            <a
              href="/reports?month=<%= curMonth %>"
              class="px-2.5 py-1.5 bg-slate-200/70 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-xl text-xs transition-colors"
            >
              Limpar
            </a>
          <% } %>
        </form>
      </div>

      <!-- Hero Card: Painel de Cálculo Financeiro & IA -->
      <div class="bg-card border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm relative overflow-hidden">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-slate-100 dark:border-slate-800/80">
          <!-- Calculation Equation Display -->
          <div class="space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-slate-400 dark:text-slate-400 uppercase tracking-wider">
                Resumo Financeiro Consolidado (<%= curMonth %>)
              </span>
              <span class="px-2 py-0.5 text-[10px] font-mono rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                GET /api/reports/summary
              </span>
            </div>

            <div class="flex flex-wrap items-baseline gap-2.5 text-slate-900 dark:text-white">
              <span class="text-3xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400">
                <%= formatCurrencyCents(totalAmountCents) %>
              </span>
              <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">
                (<%= formatDuration(totalBillableSeconds) %> faturáveis de <%= formatDuration(totalSeconds) %> totais &times; <%= formatCurrencyCents(hourlyRateCents) %>/h)
              </span>
            </div>

            <p class="text-xs text-slate-500 dark:text-slate-400">
              Total apurado em <strong><%= timeEntries ? timeEntries.length : 0 %></strong> apontamentos e <strong><%= (typeof summaryProjects !== 'undefined' && summaryProjects) ? summaryProjects.length : 0 %></strong> projeto(s) ativo(s) no período.
            </p>
          </div>

          <!-- Actions: IA Insight & Create Invoice -->
          <div class="flex flex-wrap items-center gap-3">
            <!-- Botão 2: POST /api/reports/ai-insight -->
            <button
              type="button"
              id="btn-ai-summary"
              onclick="triggerAiSummary()"
              class="px-4 py-2.5 rounded-xl text-xs font-bold text-purple-700 dark:text-purple-300 bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/30 transition-all flex items-center gap-2 cursor-pointer shadow-sm hover:scale-[1.02] active:scale-95"
            >
              <svg id="ai-icon" class="w-4 h-4 text-purple-500 animate-spin hidden" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="ai-btn-text">✨ Gerar Insight com IA (gpt-oss:120b)</span>
            </button>

            <!-- Botão 3: POST /api/invoices/generate -->
            <button
              type="button"
              onclick="openInvoiceModal()"
              class="px-4 py-2.5 rounded-xl text-xs font-bold text-white bg-play hover:bg-play/90 transition-all flex items-center gap-2 cursor-pointer shadow-sm shadow-emerald-500/20 hover:scale-[1.02] active:scale-95"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <span>Gerar e Enviar Fatura</span>
            </button>
          </div>
        </div>

        <!-- KPI Summary Mini-Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-5">
          <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-background/60 border border-slate-200/70 dark:border-slate-800">
            <span class="text-[11px] text-slate-500 dark:text-slate-400 block">Tempo Total</span>
            <span class="text-lg font-bold font-mono text-slate-900 dark:text-white"><%= formatDuration(totalSeconds) %></span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-background/60 border border-slate-200/70 dark:border-slate-800">
            <span class="text-[11px] text-slate-500 dark:text-slate-400 block">Tempo Faturável</span>
            <span class="text-lg font-bold font-mono text-emerald-600 dark:text-emerald-400"><%= formatDuration(totalBillableSeconds) %></span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-background/60 border border-slate-200/70 dark:border-slate-800">
            <span class="text-[11px] text-slate-500 dark:text-slate-400 block">Taxa Horária Base</span>
            <span class="text-lg font-bold font-mono text-slate-900 dark:text-white"><%= formatCurrencyCents(hourlyRateCents) %>/h</span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-background/60 border border-slate-200/70 dark:border-slate-800">
            <span class="text-[11px] text-slate-500 dark:text-slate-400 block">Faturas Emitidas</span>
            <span class="text-lg font-bold font-mono text-slate-900 dark:text-white"><%= invoices ? invoices.length : 0 %></span>
          </div>
        </div>

        <!-- AI Summary Live Preview Card (exibido ao chamar POST /api/reports/ai-insight) -->
        <div id="ai-summary-card" class="mt-5 p-5 rounded-xl bg-purple-500/5 border border-purple-500/20 text-xs hidden">
          <div class="flex flex-wrap items-center justify-between gap-2 pb-3 mb-3 border-b border-purple-500/15">
            <div class="flex items-center gap-2">
              <span class="font-bold text-purple-700 dark:text-purple-300 flex items-center gap-1.5">
                🤖 Insight Executivo Gerado por IA (Ollama Cloud • gpt-oss:120b)
              </span>
              <span id="ai-summary-meta" class="px-2 py-0.5 text-[10px] font-mono rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-300"></span>
            </div>
            <div class="flex items-center gap-2">
              <button
                type="button"
                onclick="copyAiSummary()"
                class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-purple-500/10 hover:bg-purple-500/20 text-purple-700 dark:text-purple-300 transition-colors cursor-pointer"
              >
                Copiar Texto
              </button>
              <button
                type="button"
                onclick="openInvoiceModal()"
                class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-play hover:bg-play/90 text-white transition-colors cursor-pointer"
              >
                Usar na Fatura
              </button>
              <button
                type="button"
                onclick="document.getElementById('ai-summary-card').classList.add('hidden')"
                class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-base leading-none px-1"
              >&times;</button>
            </div>
          </div>
          <div id="ai-summary-content" class="text-slate-700 dark:text-slate-200 leading-relaxed whitespace-pre-wrap font-sans text-xs"></div>
        </div>
      </div>

      <!-- Table 1: Resumo de Horas e Faturamento por Projeto (GET /api/reports/summary) -->
      <div class="bg-card border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-sm p-6 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-100 dark:border-slate-800/80">
          <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>Resumo de Horas e Faturamento por Projeto</span>
              <span class="px-2 py-0.5 text-[10px] font-mono font-normal rounded bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                Agrupado
              </span>
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Consolidação de tempo total, faturável, orçamento/estimativa consumida e valor financeiro por projeto
            </p>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 dark:bg-background/50 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 uppercase tracking-wider font-semibold">
              <tr>
                <th class="px-4 py-3">Projeto</th>
                <th class="px-4 py-3">Cliente</th>
                <th class="px-4 py-3">Apontamentos</th>
                <th class="px-4 py-3">Orçamento / Estimativa</th>
                <th class="px-4 py-3">Tempo Total</th>
                <th class="px-4 py-3">Tempo Faturável</th>
                <th class="px-4 py-3 text-right">Valor Faturável</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80">
              <% if (typeof summaryProjects === 'undefined' || !summaryProjects || summaryProjects.length === 0) { %>
                <tr>
                  <td colspan="7" class="px-4 py-8 text-center text-slate-400">
                    Nenhum projeto com tempo apontado para os filtros selecionados neste período.
                  </td>
                </tr>
              <% } else { %>
                <% summaryProjects.forEach(function(proj) { %>
                  <%
                    const projTotalSec = Number(proj.totalSeconds || 0);
                    const projBillSec = Number(proj.billableSeconds ?? projTotalSec);
                    const projAmountCents = Number(proj.amountCents ?? Math.round((proj.totalValue || 0) * 100));
                    const estSec = proj.estimatedSeconds ? Number(proj.estimatedSeconds) : (proj.budgetHours ? Math.round(Number(proj.budgetHours) * 3600) : 0);
                    const budgetCents = proj.budgetCents ? Number(proj.budgetCents) : 0;
                    let pct = 0;
                    let hasProgress = false;
                    let progressLabel = '';
                    if (budgetCents > 0) {
                      hasProgress = true;
                      pct = Math.min(100, Math.round((projAmountCents / budgetCents) * 100));
                      progressLabel = `${formatCurrencyCents(projAmountCents)} / ${formatCurrencyCents(budgetCents)}`;
                    } else if (estSec > 0) {
                      hasProgress = true;
                      pct = Math.min(100, Math.round((projTotalSec / estSec) * 100));
                      progressLabel = `${formatDuration(projTotalSec)} / ${formatDuration(estSec)}`;
                    }
                  %>
                  <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
                    <td class="px-4 py-3.5 font-bold text-slate-900 dark:text-white">
                      <%= proj.projectName || 'Sem projeto' %>
                    </td>
                    <td class="px-4 py-3.5 text-slate-600 dark:text-slate-300">
                      <%= proj.clientName || 'Sem cliente' %>
                    </td>
                    <td class="px-4 py-3.5 font-mono text-slate-500 dark:text-slate-400">
                      <%= proj.entriesCount %> reg.
                    </td>
                    <td class="px-4 py-3.5">
                      <% if (hasProgress) { %>
                        <div class="w-44 space-y-1">
                          <div class="flex justify-between text-[10px] font-mono text-slate-500 dark:text-slate-400 gap-2">
                            <span class="truncate"><%= progressLabel %></span>
                            <span><%= pct %>%</span>
                          </div>
                          <div class="w-full h-1.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                            <div
                              class="h-full rounded-full <%= pct >= 100 ? 'bg-red-500' : (pct >= 80 ? 'bg-amber-500' : 'bg-emerald-500') %>"
                              style="width: <%= pct %>%"
                            ></div>
                          </div>
                        </div>
                      <% } else { %>
                        <span class="text-slate-400 font-mono text-[11px]">Livre</span>
                      <% } %>
                    </td>
                    <td class="px-4 py-3.5 font-mono font-semibold text-slate-700 dark:text-slate-200">
                      <%= formatDuration(projTotalSec) %>
                    </td>
                    <td class="px-4 py-3.5 font-mono font-semibold text-emerald-600 dark:text-emerald-400">
                      <%= formatDuration(projBillSec) %>
                    </td>
                    <td class="px-4 py-3.5 text-right font-mono font-bold text-slate-900 dark:text-white">
                      <%= formatCurrencyCents(projAmountCents) %>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Table 2: Histórico de Faturas Emitidas (POST /api/invoices/generate, POST /send, PATCH /status) -->
      <div class="bg-card border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-sm p-6 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-100 dark:border-slate-800/80">
          <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Histórico de Faturas Emitidas</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Gerencie o status de pagamento (<code>pendente</code>, <code>pago</code>, <code>cancelado</code>), visualize o documento da fatura e envie por e-mail via Resend
            </p>
          </div>
          <button
            type="button"
            onclick="openInvoiceModal()"
            class="px-3 py-1.5 rounded-xl text-xs font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 transition-colors cursor-pointer self-start sm:self-auto"
          >
            + Nova Fatura
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 dark:bg-background/50 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 uppercase tracking-wider font-semibold">
              <tr>
                <th class="px-4 py-3">Cliente</th>
                <th class="px-4 py-3">Mês / Ref</th>
                <th class="px-4 py-3">Tempo Apurado</th>
                <th class="px-4 py-3">Valor Total</th>
                <th class="px-4 py-3">Status</th>
                <th class="px-4 py-3">Emissão / Pagamento</th>
                <th class="px-4 py-3 text-right">Ações</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80">
              <% if (!invoices || invoices.length === 0) { %>
                <tr>
                  <td colspan="7" class="px-4 py-10 text-center text-slate-400">
                    Nenhuma fatura emitida ainda. Clique em <strong>Gerar e Enviar Fatura</strong> acima para faturar seu primeiro cliente.
                  </td>
                </tr>
              <% } else { %>
                <% invoices.forEach(function(inv) { %>
                  <%
                    const invDurSeconds = inv.durationSeconds !== undefined && inv.durationSeconds !== null
                      ? Number(inv.durationSeconds)
                      : Math.round((Number(inv.totalHours) || 0) * 3600);
                    const invAmountCents = inv.amountCents !== undefined && inv.amountCents !== null
                      ? Number(inv.amountCents)
                      : Math.round((Number(inv.totalValue) || 0) * 100);
                  %>
                  <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
                    <td class="px-4 py-3.5">
                      <div class="font-bold text-slate-900 dark:text-white">
                        <%= inv.client ? inv.client.name : 'Cliente' %>
                      </div>
                      <% if (inv.client && inv.client.contact) { %>
                        <div class="text-[11px] text-slate-400 font-mono"><%= inv.client.contact %></div>
                      <% } %>
                    </td>
                    <td class="px-4 py-3.5 font-mono text-slate-600 dark:text-slate-300">
                      <%= inv.monthRef %>
                    </td>
                    <td class="px-4 py-3.5 font-mono">
                      <%= formatDuration(invDurSeconds) %>
                    </td>
                    <td class="px-4 py-3.5 font-mono font-bold text-emerald-600 dark:text-emerald-400">
                      <%= formatCurrencyCents(invAmountCents) %>
                    </td>
                    <td class="px-4 py-3.5">
                      <% if (inv.status === 'pago') { %>
                        <span class="px-2.5 py-0.5 text-[10px] font-semibold rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                          ● Pago
                        </span>
                      <% } else if (inv.status === 'cancelado') { %>
                        <span class="px-2.5 py-0.5 text-[10px] font-semibold rounded-full bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20">
                          ● Cancelado
                        </span>
                      <% } else { %>
                        <span class="px-2.5 py-0.5 text-[10px] font-semibold rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                          ● Pendente
                        </span>
                      <% } %>
                    </td>
                    <td class="px-4 py-3.5 text-slate-400 font-mono text-[11px]">
                      <div>Emitida: <%= new Date(inv.createdAt).toLocaleDateString('pt-BR') %></div>
                      <% if (inv.paidAt) { %>
                        <div class="text-emerald-500">Pago em: <%= new Date(inv.paidAt).toLocaleDateString('pt-BR') %></div>
                      <% } %>
                    </td>
                    <td class="px-4 py-3.5 text-right">
                      <div class="flex flex-wrap items-center justify-end gap-1.5">
                        <!-- Ver Documento PDF/HTML (pdfUrl) -->
                        <% if (inv.pdfUrl) { %>
                          <button
                            type="button"
                            data-pdf="<%= inv.pdfUrl %>"
                            data-client="<%= inv.client ? inv.client.name : 'Cliente' %>"
                            data-month="<%= inv.monthRef %>"
                            onclick="openPdfPreviewModal(this)"
                            class="px-2.5 py-1 text-[11px] font-medium text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-lg transition-colors border border-slate-200 dark:border-slate-700 cursor-pointer"
                            title="Visualizar Documento da Fatura"
                          >
                            📄 Fatura
                          </button>
                        <% } %>

                        <!-- Ver Resumo IA -->
                        <% if (inv.aiSummary) { %>
                          <button
                            type="button"
                            data-summary="<%= encodeURIComponent(inv.aiSummary) %>"
                            data-client="<%= inv.client ? inv.client.name : 'Cliente' %>"
                            data-month="<%= inv.monthRef %>"
                            onclick="openAiSummaryModalFromBtn(this)"
                            class="px-2.5 py-1 text-[11px] font-medium text-purple-600 dark:text-purple-400 hover:bg-purple-500/10 rounded-lg transition-colors border border-purple-500/20 cursor-pointer"
                            title="Ver Resumo Executivo Gerado pela IA"
                          >
                            🤖 Resumo IA
                          </button>
                        <% } %>

                        <!-- Enviar por E-mail via Resend (POST /api/invoices/:id/send) -->
                        <button
                          type="button"
                          data-id="<%= inv.id %>"
                          data-client="<%= inv.client ? inv.client.name : 'Cliente' %>"
                          data-email="<%= (inv.client && inv.client.contact && inv.client.contact.includes('@')) ? inv.client.contact : 'hugovictorgutierrez@gmail.com' %>"
                          data-month="<%= inv.monthRef %>"
                          onclick="openSendInvoiceModal(this)"
                          class="px-2.5 py-1 text-[11px] font-semibold text-sky-600 dark:text-sky-400 hover:bg-sky-500/10 rounded-lg transition-colors border border-sky-500/20 cursor-pointer"
                          title="Disparar Fatura por E-mail (Resend)"
                        >
                          ✉️ Enviar E-mail
                        </button>

                        <!-- Alterar Status (PATCH /api/invoices/:id/status) -->
                        <select
                          aria-label="Alterar status da fatura"
                          onchange="changeInvoiceStatus('<%= inv.id %>', this.value)"
                          class="px-2 py-1 text-[11px] font-semibold bg-card border border-slate-200 dark:border-slate-700 rounded-lg text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-1 focus:ring-emerald-500 cursor-pointer"
                        >
                          <option value="pendente" <%= inv.status === 'pendente' ? 'selected' : '' %>>Pendente</option>
                          <option value="pago" <%= inv.status === 'pago' ? 'selected' : '' %>>Pago</option>
                          <option value="cancelado" <%= inv.status === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
                        </select>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Table 3: Detalhamento de Atividades do Período (sem coluna Tarefa) -->
      <div class="bg-card border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-sm p-6 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800/80">
          <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Detalhamento de Atividades do Período</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Sessões de tempo filtradas que compõem a base do relatório e do insight de IA</p>
          </div>
          <div class="text-xs font-mono text-slate-500 dark:text-slate-400">
            Total: <strong><%= formatDuration(totalSeconds) %></strong> (Faturável: <strong><%= formatDuration(totalBillableSeconds) %></strong>)
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 dark:bg-background/50 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 uppercase tracking-wider font-semibold">
              <tr>
                <th class="px-4 py-3">Data</th>
                <th class="px-4 py-3">Projeto</th>
                <th class="px-4 py-3">Descrição da Atividade</th>
                <th class="px-4 py-3">Duração</th>
                <th class="px-4 py-3">Faturável</th>
                <th class="px-4 py-3 text-right">Valor Estimado</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80">
              <% if (!timeEntries || timeEntries.length === 0) { %>
                <tr>
                  <td colspan="6" class="px-4 py-10 text-center text-slate-400">
                    Nenhum apontamento encontrado para os filtros selecionados.
                  </td>
                </tr>
              <% } else { %>
                <% timeEntries.forEach(function(entry) { %>
                  <%
                    const durSeconds = Number(entry.durationSeconds ?? entry.duration ?? 0);
                    const dateFormatted = entry.start ? new Date(entry.start).toLocaleDateString('pt-BR') : '-';
                    const estimatedCents = entry.billable
                      ? ((entry.amountCents !== undefined && entry.amountCents !== null && Number(entry.amountCents) > 0)
                          ? Number(entry.amountCents)
                          : calculateAmountCents(durSeconds, hourlyRateCents))
                      : 0;
                  %>
                  <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
                    <td class="px-4 py-3 text-slate-500 dark:text-slate-400 font-mono text-[11px]">
                      <%= dateFormatted %>
                    </td>
                    <td class="px-4 py-3 font-medium text-slate-900 dark:text-white">
                      <% if (entry.project) { %>
                        <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                          <%= entry.project.name %>
                        </span>
                      <% } else { %>
                        <span class="text-slate-400">-</span>
                      <% } %>
                    </td>
                    <td class="px-4 py-3 text-slate-700 dark:text-slate-300">
                      <%= entry.description || '(Sem descrição)' %>
                    </td>
                    <td class="px-4 py-3 font-mono font-semibold text-slate-800 dark:text-slate-200">
                      <%= formatDuration(durSeconds) %>
                    </td>
                    <td class="px-4 py-3">
                      <% if (entry.billable) { %>
                        <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">Sim</span>
                      <% } else { %>
                        <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400">Não</span>
                      <% } %>
                    </td>
                    <td class="px-4 py-3 text-right font-mono font-semibold text-slate-900 dark:text-white">
                      <%= formatCurrencyCents(estimatedCents) %>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- MODAL 1: Gerar e Enviar Fatura (POST /api/invoices/generate) -->
<div id="modal-invoice" class="fixed inset-0 bg-slate-900/60 z-50 backdrop-blur-sm hidden flex items-center justify-center p-4">
  <div class="bg-card border border-slate-200 dark:border-slate-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-4 max-h-[92vh] overflow-y-auto animate-scale-in">
