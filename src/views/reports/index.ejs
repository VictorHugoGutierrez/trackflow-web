            class="w-full px-3 py-2.5 bg-slate-50 dark:bg-background border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 font-mono font-bold text-emerald-600 dark:text-emerald-400"
