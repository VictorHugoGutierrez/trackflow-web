          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Tempo Faturável</label>
          <input
            type="text"
            id="invoice-duration-display"
            value="<%= formatDuration(totalBillableSeconds) %>"
            readonly
            class="w-full px-3 py-2.5 bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-700 dark:text-slate-200 font-mono"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Valor Total (R$)</label>
          <input
            type="number"
            step="0.01"
            min="0"
            name="totalValue"
            id="invoice-total-value"
            value="<%= centsToReaisInput(totalAmountCents) %>"
