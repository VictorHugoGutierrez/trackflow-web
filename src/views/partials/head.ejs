<!DOCTYPE html>
<html lang="pt-BR" class="h-full dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'TrackFlow' %></title>
  
  <script>
    if (localStorage.getItem('trackflow-theme') === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }

    function toggleTheme() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('trackflow-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('trackflow-theme', 'dark');
      }
    }
  </script>

  <!-- Tema Original do TrackFlow (Variáveis CSS HSL Base) -->
  <style>
    :root {
      /* Tema Claro Original do TrackFlow */
      --background: 210 40% 96%; /* #F1F5F9 */
      --foreground: 222.2 47.4% 11.2%; /* #0F172A */
      --card: 0 0% 100%; /* #FFFFFF */
      --play: 161 94% 30%; /* #059669 */
      --stop: 0 72% 51%; /* #DC2626 */
    }

    .dark {
      /* Tema Escuro Original do TrackFlow */
      --background: 222.2 47.4% 11.2%; /* #0F172A */
      --foreground: 210 40% 98%; /* #F8FAFC */
      --card: 215 27.9% 16.9%; /* #1E293B */
      --play: 160 84% 39%; /* #10B981 */
      --stop: 0 84% 60%; /* #EF4444 */
    }

    body {
      background-color: hsl(var(--background));
      color: hsl(var(--foreground));
      font-family: 'Inter', sans-serif;
    }
  </style>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            background: 'hsl(var(--background) / <alpha-value>)',
            foreground: 'hsl(var(--foreground) / <alpha-value>)',
            card: {
              DEFAULT: 'hsl(var(--card) / <alpha-value>)',
              foreground: 'hsl(var(--foreground) / <alpha-value>)'
            },
            play: {
              DEFAULT: 'hsl(var(--play) / <alpha-value>)',
              hover: 'hsl(var(--play) / 0.9)',
              foreground: '#FFFFFF'
            },
            stop: {
              DEFAULT: 'hsl(var(--stop) / <alpha-value>)',
              hover: 'hsl(var(--stop) / 0.9)',
              foreground: '#FFFFFF'
            },
            'play-color': 'hsl(var(--play) / <alpha-value>)',
            'stop-color': 'hsl(var(--stop) / <alpha-value>)',
            dark: {
              bg: '#0F172A',
              card: '#1E293B',
              text: '#F8FAFC'
            },
            light: {
              bg: '#F1F5F9',
              card: '#FFFFFF',
              text: '#0F172A'
            }
          }
        }
      }
    }
  </script>

  <style type="text/tailwindcss">
    @layer base {
      :root {
        /* Tema Claro Original do TrackFlow */
        --background: 210 40% 96%; /* #F1F5F9 */
        --foreground: 222.2 47.4% 11.2%; /* #0F172A */
        --card: 0 0% 100%; /* #FFFFFF */
        --play: 161 94% 30%; /* #059669 */
        --stop: 0 72% 51%; /* #DC2626 */
      }

      .dark {
        /* Tema Escuro Original do TrackFlow */
        --background: 222.2 47.4% 11.2%; /* #0F172A */
        --foreground: 210 40% 98%; /* #F8FAFC */
        --card: 215 27.9% 16.9%; /* #1E293B */
        --play: 160 84% 39%; /* #10B981 */
        --stop: 0 84% 60%; /* #EF4444 */
      }
    }
  </style>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="min-h-full flex flex-col bg-background text-foreground transition-colors">
