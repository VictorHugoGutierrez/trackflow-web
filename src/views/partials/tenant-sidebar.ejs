<!-- Tenant Sidebar -->
<aside
  id="tenant-sidebar"
  class="w-64 bg-card dark:bg-background border-r border-slate-200 dark:border-slate-800 flex flex-col shrink-0 min-h-screen text-slate-700 dark:text-slate-300 select-none z-30 transition-all duration-300 fixed inset-y-0 left-0 md:static -translate-x-full md:translate-x-0"
>
  <!-- Brand Header -->
  <div class="h-16 px-6 flex items-center justify-between border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-500 font-bold shadow-sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="2"/>
          <polyline points="12 6 12 12 16 14" stroke-width="2"/>
        </svg>
      </div>
      <div>
        <div class="font-bold text-base text-slate-900 dark:text-white tracking-tight">TrackFlow</div>
        <div class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold uppercase tracking-wider">Workspace</div>
      </div>
    </div>
    
    <!-- Mobile close button -->
    <button
      type="button"
      onclick="toggleMobileSidebar()"
      class="md:hidden p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-white rounded-lg"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Navigation Links -->
  <div class="px-4 py-5 space-y-6 flex-1 overflow-y-auto">
    <div class="space-y-1">
      <div class="px-3 text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Operacional</div>

      <!-- Dashboard -->
      <a
        href="/dashboard"
        class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-medium transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'dashboard' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold border border-emerald-500/20 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60' %>"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span>Dashboard & Timer</span>
      </a>

      <!-- Clientes e Projetos -->
      <a
        href="/projects"
        class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-medium transition-all <%= typeof activeTab !== 'undefined' && (activeTab === 'projects' || activeTab === 'clients') ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold border border-emerald-500/20 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60' %>"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
        </svg>
        <span>Clientes & Projetos</span>
      </a>

      <!-- Relatórios e Faturas -->
      <a
        href="/reports"
        class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-medium transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'reports' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold border border-emerald-500/20 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60' %>"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <span>Relatórios & Faturas</span>
      </a>
    </div>

    <!-- Gestão & Workspace Section -->
    <div class="space-y-1">
      <div class="px-3 text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Administração</div>

      <!-- Equipe -->
      <a
        href="/team"
        class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-medium transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'team' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold border border-emerald-500/20 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60' %>"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <span>Gestão de Equipe</span>
      </a>

      <!-- Configurações -->
      <a
        href="/settings"
        class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-medium transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'settings' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold border border-emerald-500/20 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60' %>"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span>Configurações</span>
      </a>
    </div>
  </div>

  <!-- Workspace & User Footer -->
  <div class="p-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-[#0B0F19]">
    <div class="flex items-center justify-between mb-3">
      <div class="min-w-0 pr-2">
        <div class="text-[11px] font-bold text-slate-800 dark:text-white truncate">
          <%= typeof user !== 'undefined' && user && user.tenantName ? user.tenantName : 'Workspace Ativo' %>
        </div>
        <div class="text-[10px] text-slate-500 dark:text-slate-400 font-mono flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span><%= typeof user !== 'undefined' && user && user.tenantPlan ? user.tenantPlan.toUpperCase() : 'PRO' %></span>
        </div>
      </div>
      <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
        <%= typeof user !== 'undefined' && user && user.role ? user.role : 'OWNER' %>
      </span>
    </div>

    <div class="flex items-center justify-between pt-2 border-t border-slate-200/60 dark:border-slate-800/60">
      <div class="text-[11px] text-slate-500 dark:text-slate-400 truncate">
        <%= typeof user !== 'undefined' && user ? (user.name || user.email) : '' %>
      </div>
      <a
        href="/logout"
        class="p-1.5 text-slate-400 hover:text-red-500 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 rounded-lg transition-colors"
        title="Encerrar Sessão"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
      </a>
    </div>
  </div>
</aside>

<!-- Mobile Overlay Backdrop -->
<div
  id="sidebar-overlay"
  onclick="toggleMobileSidebar()"
  class="fixed inset-0 bg-slate-900/60 z-20 backdrop-blur-sm hidden md:hidden transition-opacity"
></div>

<script>
  function toggleMobileSidebar() {
    const sidebar = document.getElementById('tenant-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    if (!sidebar || !overlay) return;
    
    const isClosed = sidebar.classList.contains('-translate-x-full');
    if (isClosed) {
      sidebar.classList.remove('-translate-x-full');
      overlay.classList.remove('hidden');
    } else {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('hidden');
    }
  }
</script>
