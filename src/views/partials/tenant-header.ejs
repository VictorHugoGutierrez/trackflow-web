<header class="w-full border-b border-slate-200 dark:border-slate-800 bg-card/90 backdrop-blur sticky top-0 z-20 overflow-x-clip">
  <div class="px-2.5 lg:px-6 h-16 flex items-center justify-between gap-1.5 lg:gap-3 min-w-0">
    
    <div class="flex md:hidden xl:flex items-center gap-2 lg:gap-3 shrink-0 min-w-0">
      <button
        type="button"
        onclick="toggleMobileSidebar()"
        class="md:hidden p-2 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors shrink-0"
        title="Abrir Menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>

      <div class="hidden xl:flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 min-w-0">
        <span class="font-semibold text-slate-900 dark:text-white shrink-0">Workspace</span>
        <span class="shrink-0">/</span>
        <span class="text-emerald-600 dark:text-emerald-400 font-medium truncate max-w-[140px]">
          <%= typeof pageTitle !== 'undefined' ? pageTitle.replace('TrackFlow - ', '') : 'Dashboard' %>
        </span>
      </div>
    </div>

    <div class="flex items-center gap-1 lg:gap-2 flex-1 min-w-0 max-w-2xl mx-auto justify-center">
      <div class="relative flex-1 min-w-[60px] max-w-xs hidden md:block">
        <input
          type="text"
          id="global-timer-desc"
          placeholder="No que você está trabalhando?"
          class="w-full min-w-0 truncate px-2 lg:px-3 py-1.5 text-xs bg-slate-50 dark:bg-[#1E293B] border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-all font-normal"
        />
      </div>

      <div class="hidden md:block shrink-0 min-w-0">
        <select
          id="global-timer-project"
          class="px-1.5 lg:px-2.5 py-1.5 bg-slate-50 dark:bg-[#1E293B] border border-slate-200 dark:border-slate-700 rounded-lg text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-1 focus:ring-emerald-500 w-[96px] lg:w-auto lg:max-w-[135px] xl:max-w-[155px] truncate"
        >
          <option value="">Sem projeto</option>
          <% if (typeof projects !== 'undefined' && projects && projects.length > 0) { %>
            <% projects.forEach(function(p) { %>
              <% if (p.status !== 'COMPLETED') { %>
                <option value="<%= p.id %>"><%= p.name %></option>
              <% } %>
            <% }); %>
          <% } %>
        </select>
      </div>

      <button
        type="button"
        id="global-pomodoro-toggle"
        onclick="togglePomodoroMode()"
        class="hidden sm:inline-flex items-center gap-1.5 px-1.5 lg:px-2.5 py-1.5 text-[11px] font-medium rounded-lg border border-slate-200 dark:border-slate-700 hover:border-emerald-500/50 bg-slate-50 dark:bg-[#1E293B] text-slate-600 dark:text-slate-300 transition-colors shrink-0"
        title="Alternar Modo Pomodoro (25m foco / 5m intervalo)"
      >
        <span id="pomodoro-icon" class="text-sm">⏱️</span>
        <span id="pomodoro-label" class="hidden xl:inline">Normal</span>
      </button>

      <div class="px-1.5 lg:px-3 py-1 bg-slate-100 dark:bg-[#1E293B] border border-slate-200 dark:border-slate-700 rounded-lg flex items-center justify-center min-w-[68px] lg:min-w-[90px] shadow-inner shrink-0">
        <span id="global-timer-clock" class="text-xs sm:text-sm md:text-xs lg:text-base font-bold font-mono tabular-nums text-slate-900 dark:text-white tracking-wide lg:tracking-widest">
          00:00:00
        </span>
      </div>

      <button
        type="button"
        id="mobile-timer-toggle-btn"
        onclick="toggleMobileTimerBar()"
        aria-label="Definir tarefa e projeto"
        title="Definir atividade e projeto"
        class="md:hidden p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-[#1E293B] text-slate-600 dark:text-slate-300 hover:text-emerald-500 transition-colors shrink-0 cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
      </button>

      <button
        type="button"
        id="global-timer-btn"
        onclick="toggleGlobalTimer()"
        class="h-9 px-2.5 lg:px-3.5 rounded-lg font-bold text-xs flex items-center gap-1 lg:gap-1.5 transition-all shadow-sm cursor-pointer bg-play hover:bg-play/90 text-white shadow-play/20 active:scale-95 shrink-0 whitespace-nowrap"
      >
        <svg id="global-timer-play-icon" class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
        <svg id="global-timer-stop-icon" class="w-3.5 h-3.5 fill-current hidden shrink-0" viewBox="0 0 24 24">
          <rect x="5" y="5" width="14" height="14" rx="2" />
        </svg>
        <span id="global-timer-btn-text">Iniciar</span>
      </button>
    </div>

    <div class="flex items-center gap-1 lg:gap-3 shrink-0">
      <button
        type="button"
        id="theme-toggle-btn"
        onclick="toggleTheme()"
        aria-label="Alternar tema"
        class="p-1.5 lg:p-2 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer shrink-0"
        title="Alternar tema"
      >
        <svg id="theme-moon" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-sun" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <%
        const rawUserName = (typeof user !== 'undefined' && user && user.name) ? String(user.name).trim() : '';
        const userName = rawUserName || 'Usuário';
        const nameParts = userName.split(/\s+/).filter(Boolean);
        const userInitials = (nameParts.length >= 2 ? (nameParts[0][0] + nameParts[nameParts.length - 1][0]) : userName.substring(0, 2)).toUpperCase();
        const userRole = (typeof user !== 'undefined' && user && user.role) ? user.role : 'MEMBER';
      %>
      <div class="relative group shrink-0">
        <a href="/settings" class="flex items-center gap-2 p-1 lg:pr-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 font-bold text-xs shadow-sm shrink-0">
            <%= userInitials %>
          </div>
          <div class="hidden xl:flex flex-col text-left min-w-0">
            <span class="text-xs font-semibold text-slate-800 dark:text-white leading-tight truncate max-w-[140px]"><%= userName %></span>
            <span class="inline-flex w-fit mt-0.5 text-[9px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 leading-none uppercase"><%= userRole %></span>
          </div>
        </a>
      </div>
    </div>
  </div>

  <div id="mobile-timer-bar" class="hidden md:hidden px-3 pb-3 pt-2 border-t border-slate-200/70 dark:border-slate-800 bg-card/95 flex-col gap-2">
    <input
      type="text"
      id="mobile-timer-desc"
      placeholder="No que você está trabalhando?"
      class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#1E293B] border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-emerald-500"
    />
    <div class="flex items-center gap-2">
      <select
        id="mobile-timer-project"
        class="flex-1 min-w-0 px-2.5 py-2 bg-slate-50 dark:bg-[#1E293B] border border-slate-200 dark:border-slate-700 rounded-lg text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-1 focus:ring-emerald-500"
      >
        <option value="">Sem projeto</option>
        <% if (typeof projects !== 'undefined' && projects && projects.length > 0) { %>
          <% projects.forEach(function(p) { %>
            <% if (p.status !== 'COMPLETED') { %>
              <option value="<%= p.id %>"><%= p.name %></option>
            <% } %>
          <% }); %>
        <% } %>
      </select>
      <button
        type="button"
        onclick="togglePomodoroMode()"
        class="px-2.5 py-2 text-[11px] font-medium rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-[#1E293B] text-slate-600 dark:text-slate-300 shrink-0 cursor-pointer"
        title="Alternar Modo Pomodoro"
      >
        ⏱️ <span id="mobile-pomodoro-label">Normal</span>
      </button>
    </div>
  </div>
</header>

<%- include('modals') %>
<%- include('toast') %>
<%- include('chat-widget') %>

<script>
  (function() {
    let timerInterval = null;
    let isRunning = false;
    let activeEntryId = null;
    let timerStartTime = null;
    let pomodoroNotifiedEntryId = null;
    let isPomodoro = localStorage.getItem('trackflow-pomodoro-mode') === 'true';
    const userPomodoroWork = <%= (typeof user !== 'undefined' && user && user.pomodoroWork) ? Number(user.pomodoroWork) : 25 %>;
    const userPomodoroBreak = <%= (typeof user !== 'undefined' && user && user.pomodoroBreak) ? Number(user.pomodoroBreak) : 5 %>;
    let pomodoroDuration = Math.max(1, userPomodoroWork) * 60;

    const clockEl = document.getElementById('global-timer-clock');
    const descEl = document.getElementById('global-timer-desc');
    const projectEl = document.getElementById('global-timer-project');
    const mobileDescEl = document.getElementById('mobile-timer-desc');
    const mobileProjectEl = document.getElementById('mobile-timer-project');
    const mobileBarEl = document.getElementById('mobile-timer-bar');
    const btnEl = document.getElementById('global-timer-btn');
    const btnTextEl = document.getElementById('global-timer-btn-text');
    const playIconEl = document.getElementById('global-timer-play-icon');
    const stopIconEl = document.getElementById('global-timer-stop-icon');
    const pomodoroLabelEl = document.getElementById('pomodoro-label');
    const mobilePomodoroLabelEl = document.getElementById('mobile-pomodoro-label');

    if (descEl && mobileDescEl) {
      descEl.addEventListener('input', () => { mobileDescEl.value = descEl.value; });
      mobileDescEl.addEventListener('input', () => { descEl.value = mobileDescEl.value; });
    }
    if (projectEl && mobileProjectEl) {
      projectEl.addEventListener('change', () => { mobileProjectEl.value = projectEl.value; });
      mobileProjectEl.addEventListener('change', () => { projectEl.value = mobileProjectEl.value; });
    }

    window.toggleMobileTimerBar = function() {
      if (!mobileBarEl) return;
      if (mobileBarEl.classList.contains('hidden')) {
        mobileBarEl.classList.remove('hidden');
        mobileBarEl.classList.add('flex');
      } else {
        mobileBarEl.classList.add('hidden');
        mobileBarEl.classList.remove('flex');
      }
    };

    function updatePomodoroUI() {
      const labelText = isPomodoro ? `Pomodoro (${userPomodoroWork}m)` : 'Normal';
      [pomodoroLabelEl, mobilePomodoroLabelEl].forEach((el) => {
        if (!el) return;
        el.textContent = labelText;
        if (isPomodoro) {
          el.classList.add('text-amber-500', 'font-semibold');
        } else {
          el.classList.remove('text-amber-500', 'font-semibold');
        }
      });
    }

    window.togglePomodoroMode = function() {
      isPomodoro = !isPomodoro;
      localStorage.setItem('trackflow-pomodoro-mode', isPomodoro ? 'true' : 'false');
      updatePomodoroUI();
    };

    function formatTime(totalSeconds) {
      const h = Math.floor(totalSeconds / 3600);
      const m = Math.floor((totalSeconds % 3600) / 60);
      const s = totalSeconds % 60;
      return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    function playChime() {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.frequency.setValueAtTime(587.33, audioCtx.currentTime);
        osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.15);
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.5);
      } catch (e) {
      }
    }

    function selectProjectOption(projectId, projectName) {
      const normalizedId = projectId ? String(projectId).trim() : '';
      [projectEl, mobileProjectEl].forEach((selectEl) => {
        if (!selectEl) return;
        if (!normalizedId) {
          selectEl.value = '';
          return;
        }
        let opt = Array.from(selectEl.options).find(o => o.value === normalizedId);
        if (!opt) {
          opt = document.createElement('option');
          opt.value = normalizedId;
          opt.textContent = projectName || 'Projeto';
          selectEl.appendChild(opt);
        }
        selectEl.value = normalizedId;
      });
    }

    function renderRunningState(startTime, desc, projId, entryId, projName) {
      isRunning = true;
      timerStartTime = startTime;
      activeEntryId = entryId;
      if (pomodoroNotifiedEntryId !== entryId) {
        pomodoroNotifiedEntryId = null;
      }

      if (desc !== undefined && desc !== null) {
        if (descEl) descEl.value = desc;
        if (mobileDescEl) mobileDescEl.value = desc;
      }
      selectProjectOption(projId, projName);

      btnEl.className = 'h-9 px-2.5 lg:px-3.5 rounded-lg font-bold text-xs flex items-center gap-1 lg:gap-1.5 transition-all shadow-sm cursor-pointer bg-stop hover:bg-stop/90 text-white shadow-stop/20 active:scale-95 animate-pulse shrink-0 whitespace-nowrap';
      btnTextEl.textContent = 'Parar';
      playIconEl.classList.add('hidden');
      stopIconEl.classList.remove('hidden');

      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        const elapsedSecs = Math.max(0, Math.floor((Date.now() - timerStartTime) / 1000));
        
        if (isPomodoro && elapsedSecs >= pomodoroDuration && pomodoroNotifiedEntryId !== activeEntryId) {
          pomodoroNotifiedEntryId = activeEntryId;
          playChime();
          if (typeof showToast === 'function') {
            showToast(`Pomodoro concluído! Hora de descansar ${userPomodoroBreak} minutos.`, 'warning');
          }
          if (typeof Notification !== 'undefined' && Notification.permission === 'granted') {
            new Notification('TrackFlow: Pomodoro Concluído!', {
              body: `Hora de fazer um intervalo de ${userPomodoroBreak} minutos.`
            });
          }
        }

        clockEl.textContent = formatTime(elapsedSecs);
      }, 1000);

      const initialSecs = Math.max(0, Math.floor((Date.now() - timerStartTime) / 1000));
      clockEl.textContent = formatTime(initialSecs);
    }

    function renderStoppedState() {
      isRunning = false;
      activeEntryId = null;
      timerStartTime = null;
      pomodoroNotifiedEntryId = null;

      if (timerInterval) clearInterval(timerInterval);
      clockEl.textContent = '00:00:00';

      btnEl.className = 'h-9 px-2.5 lg:px-3.5 rounded-lg font-bold text-xs flex items-center gap-1 lg:gap-1.5 transition-all shadow-sm cursor-pointer bg-play hover:bg-play/90 text-white shadow-play/20 active:scale-95 shrink-0 whitespace-nowrap';
      btnTextEl.textContent = 'Iniciar';
      playIconEl.classList.remove('hidden');
      stopIconEl.classList.add('hidden');

      localStorage.removeItem('trackflow-active-timer');
    }

    window.toggleGlobalTimer = async function(overrides) {
      btnEl.disabled = true;

      try {
        if (!isRunning) {
          const desc = overrides && overrides.description !== undefined
            ? String(overrides.description).trim()
            : (descEl ? descEl.value.trim() : '');
          const projectId = overrides && overrides.projectId !== undefined
            ? String(overrides.projectId).trim()
            : (projectEl ? projectEl.value : '');
          const projectName = overrides && overrides.projectName ? String(overrides.projectName) : '';

          const res = await fetch('/time-entries/start', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ description: desc, projectId: projectId || undefined, billable: true })
          });

          const data = await res.json();
          if (data.success && data.data) {
            const entry = data.data;
            const resolvedProjId = entry.projectId || (entry.project ? entry.project.id : '') || projectId;
            const resolvedProjName = (entry.project ? entry.project.name : '') || projectName;
            const startTime = new Date(entry.start).getTime();
            localStorage.setItem('trackflow-active-timer', JSON.stringify({
              id: entry.id,
              start: startTime,
              description: entry.description,
              projectId: resolvedProjId,
              projectName: resolvedProjName
            }));
            renderRunningState(startTime, entry.description, resolvedProjId, entry.id, resolvedProjName);
            window.dispatchEvent(new CustomEvent('trackflow:timer-started', { detail: entry }));
          } else {
            showToast(data.error?.message || 'Não foi possível iniciar o cronômetro.', 'error');
          }
        } else {
          const desc = descEl ? descEl.value.trim() : '';
          const projectId = projectEl ? projectEl.value : '';

          const res = await fetch('/time-entries/stop', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ id: activeEntryId, description: desc, projectId: projectId || undefined })
          });

          const data = await res.json();
          if (data.success) {
            renderStoppedState();
            window.dispatchEvent(new CustomEvent('trackflow:timer-stopped', { detail: data.data }));
            if (window.location.pathname === '/dashboard') {
              window.location.reload();
            }
          } else {
            showToast(data.error?.message || 'Não foi possível parar o cronômetro.', 'error');
          }
        }
      } catch (err) {
        console.error('Erro no cronômetro:', err);
        showToast('Falha na comunicação com o servidor.', 'error');
      } finally {
        btnEl.disabled = false;
      }
    };

    window.startGlobalTimerWith = async function(description, projectId, projectName) {
      if (descEl) descEl.value = description || '';
      selectProjectOption(projectId, projectName);

      if (isRunning) {
        await fetch('/time-entries/stop', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: activeEntryId })
        }).catch(() => {});
        renderStoppedState();
      }

      if (descEl) descEl.value = description || '';
      selectProjectOption(projectId, projectName);
      await window.toggleGlobalTimer({ description: description || '', projectId: projectId || '', projectName: projectName || '' });
    };

    updatePomodoroUI();

    const saved = localStorage.getItem('trackflow-active-timer');
    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        if (parsed && parsed.start) {
          renderRunningState(parsed.start, parsed.description, parsed.projectId, parsed.id, parsed.projectName);
        }
      } catch (e) {
        localStorage.removeItem('trackflow-active-timer');
      }
    }

    <% if (typeof activeEntry !== 'undefined' && activeEntry) { %>
      const ssrStartTime = new Date(<%- JSON.stringify(activeEntry.start) %>).getTime();
      const ssrDesc = <%- JSON.stringify(activeEntry.description || "") %>;
      const ssrProj = <%- JSON.stringify(activeEntry.projectId || (activeEntry.project ? activeEntry.project.id : "") || "") %>;
      const ssrProjName = <%- JSON.stringify((activeEntry.project ? activeEntry.project.name : "") || "") %>;
      const ssrId = <%- JSON.stringify(activeEntry.id) %>;
      localStorage.setItem('trackflow-active-timer', JSON.stringify({
        id: ssrId,
        start: ssrStartTime,
        description: ssrDesc,
        projectId: ssrProj,
        projectName: ssrProjName
      }));
      renderRunningState(ssrStartTime, ssrDesc, ssrProj, ssrId, ssrProjName);
    <% } %>
  })();
</script>
