<div id="ai-chat-widget" class="fixed bottom-6 right-6 z-50">
  <button onclick="toggleChat()" class="p-3 bg-purple-600 text-white rounded-full shadow-lg">✨</button>
  <div id="chat-box" class="hidden w-80 h-96 bg-card border border-slate-200 dark:border-slate-800 rounded-2xl shadow-xl flex flex-col p-4 mb-4">
    <div class="flex-1 overflow-y-auto mb-3" id="chat-messages"></div>
    <div class="flex gap-2">
      <input type="text" id="chat-input" class="flex-1 px-2 py-1 border rounded-lg text-xs" placeholder="Pergunte à IA...">
      <button onclick="sendChatMessage()" class="px-2 py-1 bg-purple-600 text-white rounded-lg text-xs">Enviar</button>
    </div>
  </div>
</div>

<script>
  function toggleChat() {
    document.getElementById('chat-box').classList.toggle('hidden');
  }
  async function sendChatMessage() {
    const input = document.getElementById('chat-input');
    const msg = input.value;
    if (!msg) return;
    const res = await fetch('/api/ai/chat', { method: 'POST', body: JSON.stringify({ message: msg }), headers: { 'Content-Type': 'application/json' } });
    const data = await res.json();
    document.getElementById('chat-messages').innerHTML += `<div class="mb-2 text-xs"><strong>Você:</strong> ${msg}</div><div class="mb-2 text-xs"><strong>IA:</strong> ${data.data}</div>`;
    input.value = '';
  }
</script>
