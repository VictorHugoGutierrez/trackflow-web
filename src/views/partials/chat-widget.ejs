<div id="ai-chat-widget" class="fixed bottom-6 right-6 z-40 flex flex-col items-end">
  <div id="chat-box" class="hidden w-80 sm:w-96 h-96 bg-card border border-slate-200 dark:border-slate-800 rounded-2xl shadow-2xl flex-col p-4 mb-3">
    <div class="flex items-center justify-between mb-3 border-b border-slate-200 dark:border-slate-800 pb-2.5 shrink-0">
      <div>
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Assistente IA</h3>
        <p class="text-[11px] text-slate-500 dark:text-slate-400">Como posso ajudar hoje?</p>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" onclick="clearChat()" class="text-[11px] text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white px-2 py-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">Limpar</button>
        <button type="button" onclick="toggleChat()" aria-label="Fechar chat" class="w-7 h-7 flex items-center justify-center rounded-lg text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer font-bold">✕</button>
      </div>
    </div>

    <div class="flex-1 overflow-y-auto mb-3 space-y-2 text-slate-800 dark:text-slate-200 pr-1" id="chat-messages"></div>

    <div class="flex items-center gap-2 shrink-0 pt-2 border-t border-slate-200 dark:border-slate-800">
      <input type="text" id="chat-input" onkeydown="if (event.key === 'Enter') sendChatMessage()" class="flex-1 min-w-0 px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 placeholder-slate-400 border border-slate-200 dark:border-slate-700 rounded-xl text-xs focus:ring-1 focus:ring-purple-500 outline-none" placeholder="Pergunte à IA...">
      <button type="button" onclick="sendChatMessage()" class="shrink-0 px-3.5 py-2 bg-purple-600 text-white rounded-xl text-xs font-semibold hover:bg-purple-700 transition-colors cursor-pointer">Enviar</button>
    </div>
  </div>

  <button type="button" id="ai-chat-fab" onclick="toggleChat()" aria-label="Abrir Assistente IA" title="Assistente IA" class="w-12 h-12 flex items-center justify-center bg-purple-600 text-white rounded-full shadow-lg hover:bg-purple-700 transition-all hover:scale-105 cursor-pointer">✨</button>
</div>

<script>
  function toggleChat() {
    const box = document.getElementById('chat-box');
    if (!box) return;
    if (box.classList.contains('hidden')) {
      box.classList.remove('hidden');
      box.classList.add('flex');
      const input = document.getElementById('chat-input');
      if (input) setTimeout(() => input.focus(), 50);
    } else {
      box.classList.add('hidden');
      box.classList.remove('flex');
    }
  }

  function clearChat() {
    const messages = document.getElementById('chat-messages');
    if (messages) messages.innerHTML = '';
  }

  async function sendChatMessage() {
    const input = document.getElementById('chat-input');
    const msg = input ? input.value.trim() : '';
    if (!msg) return;

    const messages = document.getElementById('chat-messages');
    const userDiv = document.createElement('div');
    userDiv.className = 'mb-2 text-xs p-2 rounded-xl bg-purple-500/10 text-slate-900 dark:text-slate-100';
    userDiv.innerHTML = `<strong>Você:</strong> `;
    userDiv.appendChild(document.createTextNode(msg));
    messages.appendChild(userDiv);
    input.value = '';

    const loadingDiv = document.createElement('div');
    loadingDiv.id = 'loading';
    loadingDiv.className = 'mb-2 text-xs text-slate-400';
    loadingDiv.textContent = 'IA está digitando...';
    messages.appendChild(loadingDiv);
    messages.scrollTop = messages.scrollHeight;

    function appendChatError(errMsg) {
      const errDiv = document.createElement('div');
      errDiv.className = 'mb-2 text-xs p-2 rounded-xl bg-red-500/10 border border-red-500/20 text-red-700 dark:text-red-300';
      const strong = document.createElement('strong');
      strong.textContent = 'Erro IA: ';
      errDiv.appendChild(strong);
      errDiv.appendChild(document.createTextNode(errMsg));
      messages.appendChild(errDiv);
      messages.scrollTop = messages.scrollHeight;
    }

    try {
      const res = await fetch('/api/ai/chat', {
        method: 'POST',
        body: JSON.stringify({ message: msg }),
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        }
      });
      const data = await res.json();

      const loadingEl = document.getElementById('loading');
      if (loadingEl) loadingEl.remove();

      if (res.ok && data.success) {
        const aiDiv = document.createElement('div');
        aiDiv.className = 'mb-2 text-xs p-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200';
        const reply = typeof data.data === 'string' ? data.data : (data.data?.reply || data.data?.message || JSON.stringify(data.data));
        aiDiv.innerHTML = `<strong>IA:</strong> `;
        aiDiv.appendChild(document.createTextNode(reply));
        messages.appendChild(aiDiv);
        messages.scrollTop = messages.scrollHeight;
      } else {
        const errorMessage = data.error?.message || 'Erro ao conversar com a IA.';
        appendChatError(errorMessage);
        if (typeof showToast === 'function') showToast(errorMessage, 'error');
      }
    } catch (e) {
      const loadingEl = document.getElementById('loading');
      if (loadingEl) loadingEl.remove();
      const networkError = 'Erro ao conectar ao servidor.';
      appendChatError(networkError);
      if (typeof showToast === 'function') showToast(networkError, 'error');
    }
  }
</script>