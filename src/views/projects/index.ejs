<%- include('../partials/head') %>

<%
  function esc(str) {
    return (str || "").replace(/'/g, "\\'").replace(/"/g, '&quot;');
  }
  const pm = (typeof projectMetrics !== 'undefined' && projectMetrics) ? projectMetrics : { total: 0, inProgress: 0, completed: 0, archived: 0 };
  const cm = (typeof clientMetrics !== 'undefined' && clientMetrics) ? clientMetrics : { total: 0, active: 0, totalRevenue: '0' };
%>

<div class="flex h-screen overflow-hidden bg-background text-foreground">
  <%- include('../partials/tenant-sidebar', { activeTab: 'projects' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../partials/tenant-header') %>

    <main class="flex-1 p-4 md:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">
      <!-- Flash Feedback Alerts -->
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="p-4 text-xs bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 rounded-xl flex items-center justify-between shadow-sm animate-fade-in">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span><%= success %></span>
          </div>
          <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-base leading-none">&times;</button>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-4 text-xs bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 rounded-xl flex items-center justify-between shadow-sm animate-fade-in">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke-width="2"/>
              <line x1="12" y1="8" x2="12" y2="12" stroke-width="2"/>
              <line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2"/>
            </svg>
            <span><%= error %></span>
          </div>
          <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-base leading-none">&times;</button>
        </div>
      <% } %>

      <!-- Top Header & Tabs Navigation -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200 dark:border-slate-800">
        <div>
          <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5">
            <span>Gestão de Projetos & Clientes</span>
          </h1>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Organize centros de custo, alocação de tarefas e cadastros de clientes faturáveis
          </p>
        </div>

        <div class="flex items-center gap-3">
          <!-- Tab Navigation Switcher -->
          <div class="flex items-center p-1 bg-slate-200/80 dark:bg-[#1E293B] rounded-xl border border-slate-200 dark:border-slate-700/80">
            <a
              href="/projects?tab=projects"
              class="px-4 py-1.5 rounded-lg text-xs font-semibold transition-all <%= currentTab === 'projects' ? 'bg-card text-slate-900 dark:text-white shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white' %>"
            >
              Projetos (<%= projects ? projects.length : 0 %>)
            </a>
            <a
              href="/projects?tab=clients"
              class="px-4 py-1.5 rounded-lg text-xs font-semibold transition-all <%= currentTab === 'clients' ? 'bg-card text-slate-900 dark:text-white shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white' %>"
            >
              Clientes (<%= clients ? clients.length : 0 %>)
            </a>
          </div>

          <!-- Main CTA based on Tab -->
          <% if (currentTab === 'projects') { %>
            <button
              type="button"
              onclick="openNewProjectModal()"
              class="px-3.5 py-2 text-xs font-semibold text-white bg-play hover:bg-play/90 rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              <span>+ Novo Projeto</span>
            </button>
          <% } else { %>
            <button
              type="button"
              onclick="openNewClientModal()"
              class="px-3.5 py-2 text-xs font-semibold text-white bg-play hover:bg-play/90 rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              <span>+ Novo Cliente</span>
            </button>
          <% } %>
        </div>
      </div>

      <!-- TAB 1: PROJETOS -->
      <% if (currentTab === 'projects') { %>
        <!-- Project Metrics Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="p-4 rounded-2xl bg-card border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Total de Projetos</div>
            <div class="text-2xl font-bold text-slate-900 dark:text-white mt-1"><%= pm.total %></div>
            <div class="text-[11px] text-slate-400 mt-1">Registrados no workspace</div>
          </div>

          <div class="p-4 rounded-2xl bg-card border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Em Andamento</div>
            <div class="text-2xl font-bold text-emerald-600 dark:text-emerald-400 mt-1"><%= pm.inProgress %></div>
            <div class="text-[11px] text-slate-400 mt-1">Ativos recebendo horas</div>
          </div>

          <div class="p-4 rounded-2xl bg-card border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Concluídos</div>
            <div class="text-2xl font-bold text-blue-600 dark:text-blue-400 mt-1"><%= pm.completed %></div>
            <div class="text-[11px] text-slate-400 mt-1">Entregas finalizadas</div>
          </div>

          <div class="p-4 rounded-2xl bg-card border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Arquivados</div>
            <div class="text-2xl font-bold text-slate-500 dark:text-slate-400 mt-1"><%= pm.archived %></div>
            <div class="text-[11px] text-slate-400 mt-1">Histórico mantido</div>
          </div>
        </div>

        <!-- Projects Table -->
        <div class="bg-card border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-sm p-6 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100 dark:border-slate-800/80">
            <div>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">Lista de Projetos</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Gerencie os projetos e suas tarefas associadas</p>
            </div>
            
            <div class="relative w-full sm:w-64">
              <input
                type="text"
                id="search-projects"
                onkeyup="filterTable('search-projects', 'projects-tbody')"
                placeholder="Filtrar projetos..."
                class="w-full pl-9 pr-3 py-1.5 text-xs bg-slate-50 dark:bg-background border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-emerald-500"
              />
              <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8" stroke-width="2"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65" stroke-width="2"/>
              </svg>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 dark:bg-background/50 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 uppercase tracking-wider font-semibold">
                <tr>
                  <th class="px-4 py-3">Nome do Projeto</th>
                  <th class="px-4 py-3">Cliente</th>
                  <th class="px-4 py-3">Orçamento / Budget</th>
                  <th class="px-4 py-3">Status</th>
                  <th class="px-4 py-3 text-right">Ações</th>
                </tr>
              </thead>
              <tbody id="projects-tbody" class="divide-y divide-slate-100 dark:divide-slate-800/80">
                <% if (!projects || projects.length === 0) { %>
                  <tr>
                    <td colspan="5" class="px-4 py-12 text-center text-slate-400">
                      Nenhum projeto cadastrado. Clique em <strong>+ Novo Projeto</strong> para iniciar.
                    </td>
                  </tr>
                <% } else { %>
                  <% projects.forEach(function(p) { %>
                    <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
                      <td class="px-4 py-3.5 font-medium text-slate-900 dark:text-white">
                        <div class="flex items-center gap-2">
                          <span class="w-2 h-2 rounded-full <%= p.status === 'em_andamento' ? 'bg-emerald-500' : (p.status === 'concluido' ? 'bg-blue-500' : 'bg-slate-400') %>"></span>
                          <span class="font-bold"><%= p.name %></span>
                        </div>
                      </td>
                      <td class="px-4 py-3.5">
                        <% if (p.client) { %>
                          <span class="px-2.5 py-0.5 text-[10px] font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                            <%= p.client.name %>
                          </span>
                        <% } else { %>
                          <span class="text-slate-400 dark:text-slate-500">(Sem cliente)</span>
                        <% } %>
                      </td>
                      <td class="px-4 py-3.5 font-mono text-slate-700 dark:text-slate-300">
                        <%= p.budgetHours ? p.budgetHours + ' horas' : 'Sem limite' %>
                      </td>
                      <td class="px-4 py-3.5">
                        <% if (p.status === 'em_andamento') { %>
                          <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                            Em Andamento
                          </span>
                        <% } else if (p.status === 'concluido') { %>
                          <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
                            Concluído
                          </span>
                        <% } else { %>
                          <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                            Arquivado
                          </span>
                        <% } %>
                      </td>
                      <td class="px-4 py-3.5 text-right space-x-1">
                        <button
                          type="button"
                          onclick="openProjectTasksModal('<%= p.id %>', '<%= esc(p.name) %>')"
                          class="px-2.5 py-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500/10 rounded-lg transition-colors border border-emerald-500/20"
                          title="Gerenciar Tarefas"
                        >
                          Tarefas
                        </button>
                        <button
                          type="button"
                          onclick="openEditProjectModal('<%= p.id %>', '<%= esc(p.name) %>', '<%= p.clientId || '' %>', '<%= p.budgetHours || '' %>', '<%= p.status %>')"
                          class="p-1.5 text-slate-400 hover:text-emerald-500 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                          title="Editar Projeto"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                          </svg>
                        </button>
                        <button
                          type="button"
                          onclick="confirmDeleteProject('<%= p.id %>')"
                          class="p-1.5 text-slate-400 hover:text-red-500 rounded-lg hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors"
                          title="Excluir Projeto"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                          </svg>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      <!-- TAB 2: CLIENTES -->
      <% } else { %>
        <!-- Client Metrics Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-4 rounded-2xl bg-card border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Total de Clientes</div>
            <div class="text-2xl font-bold text-slate-900 dark:text-white mt-1"><%= cm.total %></div>
            <div class="text-[11px] text-slate-400 mt-1">Contas corporativas / pessoas físicas</div>
          </div>

          <div class="p-4 rounded-2xl bg-card border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Clientes Ativos</div>
            <div class="text-2xl font-bold text-emerald-600 dark:text-emerald-400 mt-1"><%= cm.active %></div>
            <div class="text-[11px] text-slate-400 mt-1">Habilitados para novos projetos</div>
          </div>

          <div class="p-4 rounded-2xl bg-card border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Inativos / Pausados</div>
            <div class="text-2xl font-bold text-slate-500 dark:text-slate-400 mt-1"><%= cm.inactive %></div>
            <div class="text-[11px] text-slate-400 mt-1">Sem faturamento recente</div>
          </div>
        </div>

        <!-- Clientes Table -->
        <div class="bg-card border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-sm p-6 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100 dark:border-slate-800/80">
            <div>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">Lista de Clientes Cadastrados</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Destinatários de faturas e vinculação de projetos</p>
            </div>
            
            <div class="relative w-full sm:w-64">
              <input
                type="text"
                id="search-clients"
                onkeyup="filterTable('search-clients', 'clients-tbody')"
                placeholder="Filtrar clientes..."
                class="w-full pl-9 pr-3 py-1.5 text-xs bg-slate-50 dark:bg-background border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-emerald-500"
              />
              <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8" stroke-width="2"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65" stroke-width="2"/>
              </svg>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 dark:bg-background/50 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 uppercase tracking-wider font-semibold">
                <tr>
                  <th class="px-4 py-3">Nome do Cliente</th>
                  <th class="px-4 py-3">Contato / E-mail de Cobrança</th>
                  <th class="px-4 py-3">Status</th>
                  <th class="px-4 py-3">Data de Cadastro</th>
                  <th class="px-4 py-3 text-right">Ações</th>
                </tr>
              </thead>
              <tbody id="clients-tbody" class="divide-y divide-slate-100 dark:divide-slate-800/80">
                <% if (!clients || clients.length === 0) { %>
                  <tr>
                    <td colspan="5" class="px-4 py-12 text-center text-slate-400">
                      Nenhum cliente cadastrado. Clique em <strong>+ Novo Cliente</strong> para cadastrar sua primeira empresa faturável.
                    </td>
                  </tr>
                <% } else { %>
                  <% clients.forEach(function(c) { %>
                    <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
                      <td class="px-4 py-3.5 font-bold text-slate-900 dark:text-white">
                        <%= c.name %>
                      </td>
                      <td class="px-4 py-3.5 text-slate-600 dark:text-slate-300 font-mono text-[11px]">
                        <%= c.contact || '(Sem contato cadastrado)' %>
                      </td>
                      <td class="px-4 py-3.5">
                        <% if (c.active !== false) { %>
                          <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                            Ativo
                          </span>
                        <% } else { %>
                          <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                            Inativo
                          </span>
                        <% } %>
                      </td>
                      <td class="px-4 py-3.5 text-slate-400 font-mono text-[11px]">
                        <%= c.createdAt ? new Date(c.createdAt).toLocaleDateString('pt-BR') : '-' %>
                      </td>
                      <td class="px-4 py-3.5 text-right space-x-1">
                        <button
                          type="button"
                          onclick="openEditClientModal('<%= c.id %>', '<%= esc(c.name) %>', '<%= esc(c.contact || '') %>', <%= c.active !== false ? 'true' : 'false' %>)"
                          class="p-1.5 text-slate-400 hover:text-emerald-500 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                          title="Editar Cliente"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                          </svg>
                        </button>
                        <button
                          type="button"
                          onclick="confirmDeleteClient('<%= c.id %>')"
                          class="p-1.5 text-slate-400 hover:text-red-500 rounded-lg hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors"
                          title="Excluir Cliente"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                          </svg>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </main>
  </div>
</div>

<!-- MODAL: Novo Projeto -->
<div id="modal-new-project" class="fixed inset-0 bg-slate-900/60 z-50 backdrop-blur-sm hidden flex items-center justify-center p-4">
  <div class="bg-card border border-slate-200 dark:border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-5">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
      <h3 class="text-base font-bold text-slate-900 dark:text-white">Novo Projeto</h3>
      <button type="button" onclick="closeNewProjectModal()" class="text-slate-400 hover:text-slate-600 text-lg">&times;</button>
    </div>

    <form action="/projects" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Nome do Projeto</label>
        <input
          type="text"
          name="name"
          placeholder="Ex: Refatoração Front-end Web"
          required
          class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-background border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Cliente Associado</label>
        <select
          name="clientId"
          class="w-full px-3 py-2.5 bg-slate-50 dark:bg-background border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500"
        >
          <option value="">(Sem cliente vinculado)</option>
          <% if (clients && clients.length > 0) { %>
            <% clients.forEach(function(c) { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Orçamento (Horas)</label>
          <input
            type="number"
            step="0.5"
            name="budgetHours"
            placeholder="Ex: 40"
            class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-background border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Status Inicial</label>
          <select
            name="status"
            class="w-full px-3 py-2.5 bg-slate-50 dark:bg-background border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500"
          >
            <option value="em_andamento">Em Andamento</option>
            <option value="concluido">Concluído</option>
            <option value="arquivado">Arquivado</option>
          </select>
        </div>
      </div>

      <div class="flex items-center justify-end gap-2 pt-4 border-t border-slate-100 dark:border-slate-800">
        <button type="button" onclick="closeNewProjectModal()" class="px-4 py-2 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl">Cancelar</button>
        <button type="submit" class="px-4 py-2 text-xs font-bold text-white bg-play hover:bg-play/90 rounded-xl">Criar Projeto</button>
      </div>
    </form>
  </div>
</div>

