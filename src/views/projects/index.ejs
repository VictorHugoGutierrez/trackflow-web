<!-- Forms Ocultos para Exclusões -->
<form id="form-delete-project" method="POST" class="hidden"></form>
<form id="form-delete-client" method="POST" class="hidden"></form>
<form id="form-delete-task" method="POST" class="hidden"></form>

<script>
  function filterTable(inputId, tbodyId) {
    const query = document.getElementById(inputId).value.toLowerCase();
    const rows = document.getElementById(tbodyId).getElementsByTagName('tr');
    for (let r of rows) {
      const text = r.innerText.toLowerCase();
      r.style.display = text.includes(query) ? '' : 'none';
    }
  }

  // Projetos Modais
  function openNewProjectModal() {
    document.getElementById('modal-new-project').classList.remove('hidden');
  }
  function closeNewProjectModal() {
    document.getElementById('modal-new-project').classList.add('hidden');
  }

  function openEditProjectModal(id, name, clientId, budgetHours, status) {
    const modal = document.getElementById('modal-edit-project');
    const form = document.getElementById('form-edit-project');
    form.action = `/projects/${id}/update`;

    document.getElementById('edit-proj-name').value = name;
    document.getElementById('edit-proj-client').value = clientId;
    document.getElementById('edit-proj-budget').value = budgetHours;
    document.getElementById('edit-proj-status').value = status || 'em_andamento';

    modal.classList.remove('hidden');
  }
  function closeEditProjectModal() {
    document.getElementById('modal-edit-project').classList.add('hidden');
  }

  function confirmDeleteProject(id) {
    if (confirm('Atenção: Ao excluir o projeto, todas as tarefas e apontamentos vinculados podem ser afetados. Confirmar exclusão?')) {
      const form = document.getElementById('form-delete-project');
      form.action = `/projects/${id}/delete`;
      form.submit();
    }
  }

  // Clientes Modais
  function openNewClientModal() {
    document.getElementById('modal-new-client').classList.remove('hidden');
  }
  function closeNewClientModal() {
    document.getElementById('modal-new-client').classList.add('hidden');
  }

  function openEditClientModal(id, name, contact, active) {
    const modal = document.getElementById('modal-edit-client');
    const form = document.getElementById('form-edit-client');
    form.action = `/clients/${id}/update`;

    document.getElementById('edit-client-name').value = name;
    document.getElementById('edit-client-contact').value = contact;
    document.getElementById('edit-client-active').checked = active;

    modal.classList.remove('hidden');
  }
  function closeEditClientModal() {
    document.getElementById('modal-edit-client').classList.add('hidden');
  }

  function confirmDeleteClient(id) {
    if (confirm('Atenção: A exclusão de um cliente pode afetar seus projetos e faturas associadas. Confirmar exclusão?')) {
      const form = document.getElementById('form-delete-client');
      form.action = `/clients/${id}/delete`;
      form.submit();
    }
  }

  // Tarefas do Projeto
  async function openProjectTasksModal(projectId, projectName) {
    document.getElementById('tasks-project-name').textContent = projectName;
    document.getElementById('task-form-project-id').value = projectId;
    const container = document.getElementById('tasks-list-container');
    container.innerHTML = '<div class="text-center py-6 text-slate-400 text-xs">Carregando tarefas...</div>';
    document.getElementById('modal-project-tasks').classList.remove('hidden');

    try {
      const res = await fetch(`/api/projects/${projectId}/tasks`);
      const json = await res.json();
      if (json.success && json.data && json.data.length > 0) {
        container.innerHTML = json.data.map(t => `
          <div class="flex items-center justify-between p-2.5 bg-slate-50 dark:bg-background rounded-xl border border-slate-200 dark:border-slate-700/80 text-xs">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full ${t.status === 'done' ? 'bg-emerald-500' : (t.status === 'doing' ? 'bg-blue-500' : 'bg-slate-400')}"></span>
              <span class="font-medium text-slate-800 dark:text-white">${t.title}</span>
              ${t.estimatedHours ? `<span class="text-[10px] text-slate-400 font-mono">(${t.estimatedHours}h)</span>` : ''}
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full ${t.status === 'done' ? 'bg-emerald-500/10 text-emerald-500' : (t.status === 'doing' ? 'bg-blue-500/10 text-blue-500' : 'bg-slate-200 dark:bg-slate-800 text-slate-400')}">
                ${t.status.toUpperCase()}
              </span>
              <button type="button" onclick="confirmDeleteTask('${t.id}')" class="text-slate-400 hover:text-red-500 p-1">
                &times;
              </button>
            </div>
          </div>
        `).join('');
      } else {
        container.innerHTML = '<div class="text-center py-6 text-slate-400 text-xs">Nenhuma tarefa cadastrada neste projeto.</div>';
      }
    } catch (e) {
      container.innerHTML = '<div class="text-center py-6 text-red-500 text-xs">Erro ao carregar tarefas.</div>';
    }
  }

  function closeProjectTasksModal() {
    document.getElementById('modal-project-tasks').classList.add('hidden');
  }

  function confirmDeleteTask(taskId) {
    if (confirm('Deseja excluir esta tarefa?')) {
      const form = document.getElementById('form-delete-task');
      form.action = `/tasks/${taskId}/delete`;
      form.submit();
    }
  }

  // Escape para fechar
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeNewProjectModal();
      closeEditProjectModal();
      closeNewClientModal();
      closeEditClientModal();
      closeProjectTasksModal();
    }
  });
</script>
