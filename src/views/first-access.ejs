<%- include('partials/head') %>

<div class="fixed top-4 right-4 z-40">
  <button
    type="button"
    id="theme-toggle-btn"
    onclick="toggleTheme()"
    aria-label="Alternar tema"
    class="p-2.5 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white bg-card border border-slate-200 dark:border-slate-800 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors shadow-sm cursor-pointer"
    title="Alternar tema"
  >
    <svg id="theme-moon" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    <svg id="theme-sun" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
  </button>
</div>

<main class="flex-1 flex items-center justify-center p-4 sm:p-6">
  <div class="w-full max-w-md space-y-6">
    <div class="text-center space-y-2">
      <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-500 mx-auto shadow-sm">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">TrackFlow</h1>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Configuração de segurança no primeiro acesso
      </p>
    </div>

    <div class="bg-card border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-xl space-y-5">
      <div class="text-left pb-3 border-b border-slate-200 dark:border-slate-800">
        <h2 class="text-base font-semibold text-slate-900 dark:text-white">Troca de Senha Obrigatória</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Por segurança, defina sua senha pessoal definitiva antes de acessar o workspace.
        </p>
      </div>

      <div id="first-access-client-error" class="hidden p-3 text-xs bg-red-500/10 border border-red-500/20 text-red-500 rounded-xl"></div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-3 text-xs bg-red-500/10 border border-red-500/20 text-red-500 rounded-xl">
          <%= error %>
        </div>
      <% } %>

      <form action="/first-access" method="POST" onsubmit="return validateFirstAccessForm(event)" class="space-y-4">
        <div class="space-y-1">
          <label for="first-new-password" class="block text-xs font-medium text-slate-700 dark:text-slate-300">
            Nova Senha (mínimo 6 caracteres)
          </label>
          <input
            type="password"
            id="first-new-password"
            name="newPassword"
            required
            minlength="6"
            autocomplete="new-password"
            placeholder="••••••••"
            class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-background text-foreground placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-play transition-all"
          />
        </div>

        <div class="space-y-1">
          <label for="first-confirm-password" class="block text-xs font-medium text-slate-700 dark:text-slate-300">
            Confirmar Nova Senha
          </label>
          <input
            type="password"
            id="first-confirm-password"
            name="confirmPassword"
            required
            minlength="6"
            autocomplete="new-password"
            placeholder="••••••••"
            class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-background text-foreground placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-play transition-all"
          />
        </div>

        <button
          type="submit"
          id="btn-first-access-submit"
          class="w-full h-11 flex items-center justify-center font-semibold text-sm rounded-xl bg-play hover:bg-play/90 text-white shadow-sm transition-colors cursor-pointer"
        >
          Confirmar e Acessar Painel
        </button>
      </form>

      <div class="pt-3 text-center border-t border-slate-100 dark:border-slate-800">
        <a href="/logout" class="text-xs font-medium text-slate-500 hover:text-red-500 dark:text-slate-400 dark:hover:text-red-400 transition-colors">
          Sair e voltar para o login
        </a>
      </div>
    </div>
  </div>
</main>

<script>
  function validateFirstAccessForm(event) {
    const pwd = document.getElementById('first-new-password')?.value || '';
    const confirmPwd = document.getElementById('first-confirm-password')?.value || '';
    const errBox = document.getElementById('first-access-client-error');

    if (errBox) {
      errBox.classList.add('hidden');
      errBox.textContent = '';
    }

    if (pwd.length < 6) {
      event.preventDefault();
      if (errBox) {
        errBox.textContent = 'A nova senha deve conter no mínimo 6 caracteres.';
        errBox.classList.remove('hidden');
      }
      return false;
    }

    if (pwd !== confirmPwd) {
      event.preventDefault();
      if (errBox) {
        errBox.textContent = 'As senhas informadas não coincidem.';
        errBox.classList.remove('hidden');
      }
      return false;
    }

    const btn = document.getElementById('btn-first-access-submit');
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Salvando...';
    }
    return true;
  }
</script>

<%- include('partials/footer') %>
