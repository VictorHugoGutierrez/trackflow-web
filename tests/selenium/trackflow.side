{
  "id": "a1b2c3d4-1111-4000-8000-000000000001",
  "version": "2.0",
  "name": "TrackFlow Web",
  "url": "http://localhost:3000",
  "tests": [
    {
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "1. Autenticacao - Protecao de rota, tema e login",
      "commands": [
        {
          "id": "c1000000-0000-4000-8000-000000000001",
          "comment": "Define janela desktop para garantir visibilidade dos controles",
          "command": "setWindowSize",
          "target": "1440x900",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000002",
          "comment": "E-mail do usuario do workspace",
          "command": "store",
          "target": "hugovictorgutierrez@gmail.com",
          "targets": [],
          "value": "userEmail"
        },
        {
          "id": "c1000000-0000-4000-8000-000000000003",
          "comment": "Senha do usuario do workspace",
          "command": "store",
          "target": "123456",
          "targets": [],
          "value": "userPassword"
        },
        {
          "id": "c1000000-0000-4000-8000-000000000004",
          "comment": "Garante que nao ha sessao ativa",
          "command": "open",
          "target": "/logout",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000005",
          "comment": "Limpa tema e estado local do navegador",
          "command": "executeScript",
          "target": "window.localStorage.removeItem('trackflow-theme'); window.localStorage.removeItem('trackflow-active-timer'); window.localStorage.removeItem('trackflow-pomodoro-mode');",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000006",
          "comment": "Tenta acessar rota protegida sem autenticacao",
          "command": "open",
          "target": "/dashboard",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000007",
          "comment": "Aguarda formulario de login apos redirecionamento",
          "command": "waitForElementVisible",
          "target": "id=form-login",
          "targets": [],
          "value": "15000"
        },
        {
          "id": "c1000000-0000-4000-8000-000000000008",
          "comment": "Captura pathname atual",
          "command": "executeScript",
          "target": "return window.location.pathname;",
          "targets": [],
          "value": "currentPath"
        },
        {
          "id": "c1000000-0000-4000-8000-000000000009",
          "comment": "Confirma redirecionamento para /login",
          "command": "assert",
          "target": "currentPath",
          "targets": [],
          "value": "/login"
        },
        {
          "id": "c1000000-0000-4000-8000-000000000101",
          "comment": "Pausa visual apos redirecionamento para /login",
          "command": "pause",
          "target": "1200",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000010",
          "comment": "Confirma tema inicial dark",
          "command": "assertElementPresent",
          "target": "css=html.dark",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000011",
          "comment": "Alterna para tema light",
          "command": "click",
          "target": "id=theme-toggle-btn",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000012",
          "comment": "Confirma remocao da classe dark",
          "command": "assertElementNotPresent",
          "target": "css=html.dark",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000102",
          "comment": "Pausa visual para ver tema claro aplicado",
          "command": "pause",
          "target": "1200",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000013",
          "comment": "Recarrega /login para validar persistencia do tema",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000014",
          "comment": "Aguarda formulario de login apos recarregar",
          "command": "waitForElementVisible",
          "target": "id=form-login",
          "targets": [],
          "value": "15000"
        },
        {
          "id": "c1000000-0000-4000-8000-000000000015",
          "comment": "Confirma que o tema light persistiu",
          "command": "assertElementNotPresent",
          "target": "css=html.dark",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000103",
          "comment": "Pausa visual apos confirmar persistencia do tema no reload",
          "command": "pause",
          "target": "1000",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000016",
          "comment": "Preenche e-mail valido",
          "command": "type",
          "target": "id=login-email",
          "targets": [],
          "value": "${userEmail}"
        },
        {
          "id": "c1000000-0000-4000-8000-000000000017",
          "comment": "Preenche senha incorreta",
          "command": "type",
          "target": "id=login-password",
          "targets": [],
          "value": "senha-incorreta"
        },
        {
          "id": "c1000000-0000-4000-8000-000000000104",
          "comment": "Pausa visual antes de enviar senha incorreta",
          "command": "pause",
          "target": "800",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000018",
          "comment": "Envia login invalido",
          "command": "click",
          "target": "id=btn-login-submit",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000019",
          "comment": "Aguarda caixa de erro ficar visivel",
          "command": "waitForElementVisible",
          "target": "id=error-box",
          "targets": [],
          "value": "15000"
        },
        {
          "id": "c1000000-0000-4000-8000-000000000020",
          "comment": "Valida mensagem real de erro retornada pela TrackFlow API",
          "command": "assertText",
          "target": "id=error-box",
          "targets": [],
          "value": "E-mail ou senha inválidos."
        },
        {
          "id": "c1000000-0000-4000-8000-000000000105",
          "comment": "Pausa visual para leitura da mensagem de erro",
          "command": "pause",
          "target": "1800",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000027",
          "comment": "Limpa campos de e-mail e senha antes de preencher credenciais validas",
          "command": "executeScript",
          "target": "document.getElementById('login-email').value = ''; document.getElementById('login-password').value = '';",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000021",
          "comment": "Preenche e-mail valido novamente",
          "command": "type",
          "target": "id=login-email",
          "targets": [],
          "value": "${userEmail}"
        },
        {
          "id": "c1000000-0000-4000-8000-000000000022",
          "comment": "Preenche senha valida",
          "command": "type",
          "target": "id=login-password",
          "targets": [],
          "value": "${userPassword}"
        },
        {
          "id": "c1000000-0000-4000-8000-000000000106",
          "comment": "Pausa visual antes de enviar login valido",
          "command": "pause",
          "target": "800",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000023",
          "comment": "Envia login valido",
          "command": "click",
          "target": "id=btn-login-submit",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000024",
          "comment": "Aguarda botao exclusivo de /dashboard para confirmar navegacao",
          "command": "waitForElementVisible",
          "target": "css=button[onclick=\"openManualModal()\"]",
          "targets": [],
          "value": "15000"
        },
        {
          "id": "c1000000-0000-4000-8000-000000000025",
          "comment": "Valida titulo da pagina do dashboard",
          "command": "assertTitle",
          "target": "TrackFlow - Painel Operacional",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1000000-0000-4000-8000-000000000026",
          "comment": "Valida cabecalho principal do dashboard",
          "command": "assertText",
          "target": "css=main h1 span",
          "targets": [],
          "value": "Visão Operacional do Dia"
        },
        {
          "id": "c1000000-0000-4000-8000-000000000107",
          "comment": "Pausa visual ao concluir login no /dashboard",
          "command": "pause",
          "target": "2000",
          "targets": [],
          "value": ""
        }
      ]
    },
