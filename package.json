{
  "name": "trackflow-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/css/styles.css --watch",
    "dev": "npm run build:css && tsx watch src/server.ts",
    "build": "npm run build:css && tsc && node -e \"fs.cpSync('src/views', 'dist/views', { recursive: true })\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "axios": "^1.7.9",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.3.1",
    "react-email": "^6.11.13",
    "resend": "^6.38.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.17.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.2",
    "@esbuild/win32-x64": "^0.28.2"
  }
}
